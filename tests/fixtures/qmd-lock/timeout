#!/bin/bash
# Fake timeout(1) with the shape of BusyBox 1.36.1 and 1.37.0 (044, #116). It is NOT a real timeout:
# it applies no limit at all.
#
# What it imitates: BusyBox's timeout leaves a watchdog child that lives about a second after the
# command ends and keeps every file descriptor it inherited, the one that holds .reindex.lock
# (fd 9) included. A flock(2) lock belongs to the open file description, so the lock stays taken
# until that watchdog dies. The watchdog moves 0, 1 and 2 to /dev/null (a daemonized watchdog does
# not keep the caller's stdio), so a $(...) around the call does not wait for it.
#
# Why it also closes fd 3: bats reports a test through fd 3, and a process that keeps it delays the
# report. fd 9 is the one that carries the defect, and it stays.
#
# Knobs (environment):
#   FAKE_TIMEOUT_LINGER   seconds the watchdog lives (default 3; 0 leaves no watchdog)
#   FAKE_TIMEOUT_PIDFILE  if set, the watchdog PID is appended to this file (the watchdog is not a
#                         child of the test, so `wait` cannot reach it; teardown kills the PIDs)
#   FAKE_TIMEOUT_ONLY     if set, the watchdog is left only when the command's base name equals it
#                         (for example `bun`)
while [ $# -gt 0 ]; do
  case "$1" in
    -k|-s) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
shift   # the duration

linger="${FAKE_TIMEOUT_LINGER:-3}"
want=1
if [ "$linger" = "0" ]; then want=0; fi
if [ -n "${FAKE_TIMEOUT_ONLY:-}" ] && [ "${1##*/}" != "$FAKE_TIMEOUT_ONLY" ]; then want=0; fi

if [ "$want" = "1" ]; then
  ( exec </dev/null >/dev/null 2>&1 3>&-; exec sleep "$linger" ) &
  if [ -n "${FAKE_TIMEOUT_PIDFILE:-}" ]; then
    echo "$!" >> "$FAKE_TIMEOUT_PIDFILE"
  fi
fi
exec "$@"

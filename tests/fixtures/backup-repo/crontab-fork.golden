# Cron for in-container agent heartbeat + identity/vault/config backup + token-health + qmd reindex + wiki-graph. Managed by heartbeatctl.
*/30 * * * * /workspace/scripts/heartbeat/heartbeat.sh >> /workspace/scripts/heartbeat/logs/cron.log 2>&1
30 3 * * * /usr/local/bin/heartbeatctl backup-identity >> /workspace/scripts/heartbeat/logs/backup-identity.log 2>&1
0 * * * * /usr/local/bin/heartbeatctl backup-vault >> /workspace/scripts/heartbeat/logs/backup-vault.log 2>&1
30 3 * * * /usr/local/bin/heartbeatctl backup-config >> /workspace/scripts/heartbeat/logs/backup-config.log 2>&1
0 * * * * /opt/agent-admin/scripts/check_token_health.sh >> /workspace/scripts/heartbeat/logs/token-health.log 2>&1

20 */6 * * * /usr/local/bin/heartbeatctl wiki-graph >> /workspace/scripts/heartbeat/logs/wiki-graph.log 2>&1

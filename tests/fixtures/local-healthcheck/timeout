#!/usr/bin/env perl
# Strict GNU subset for synthetic macOS tests. Keep ownership of the group
# through cleanup even when its leader exits before a resistant grandchild.
use strict;
use warnings;
use POSIX ':sys_wait_h';
use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC sleep);
sub _timeout_clock { clock_gettime(CLOCK_MONOTONIC) }
@ARGV >= 4 && shift(@ARGV) eq '-k' or exit 125;
my ($grace, $duration) = (shift @ARGV, shift @ARGV);
for ($grace, $duration) {
    defined($_) && /^\d+(?:\.\d+)?s?$/ or exit 125;
    s/s$//;
}
@ARGV && $ARGV[0] !~ /^-/ or exit 125;
if (defined $ENV{HC_FIX} && -d $ENV{HC_FIX}) {
    my $tool=$ARGV[0]; $tool =~ s{.*/}{};
    open my $budget, '>', "$ENV{HC_FIX}/timeout-budget-$tool" or die;
    print $budget int(($duration+$grace)*1000+0.5), "\n"; close $budget;
}
my $pid = fork();
defined $pid or exit 125;
if ($pid == 0) {
    setpgrp(0, 0);
    { no warnings 'exec'; exec {$ARGV[0]} @ARGV; }
    exit 127;
}
my $record;
if (defined $ENV{HC_FIX} && -d $ENV{HC_FIX}) {
    $record = "$ENV{HC_FIX}/timeout-active-$pid";
    open my $out, '>', $record or die "timeout registry unavailable";
    print $out "$pid $$\n";
    close $out;
}
my $timed_out = 0;
my $deadline = _timeout_clock() + $duration;
my $kill_deadline;
my $interrupted = 0;
$SIG{TERM} = sub { $interrupted = 143 };
$SIG{INT} = sub { $interrupted = 130 };
for (;;) {
    my $done = waitpid($pid, WNOHANG);
    if ($done == $pid) {
        my $status = $?;
        if ($timed_out && defined $ENV{HC_FIX} && -d $ENV{HC_FIX}) {
            my $name=$ARGV[0]; $name =~ s{.*/}{};
            $name='other' unless $name =~ /\A(?:bash|perl|jq|sync|rm|cat|stat|flock|mktemp|date|mv|sort|find|systemctl|journalctl|ss|curl)\z/;
            if (open my $log, '>>', "$ENV{HC_FIX}/timeout-failures.tsv") {
                printf $log "%s\t%.6f\t%.6f\t%.6f\t%d\n", $name,_timeout_clock()-($deadline-$duration),$duration,$grace,$status;
                close $log;
            }
        }
        kill 'KILL', -$pid;
        unlink $record if defined $record;
        exit $interrupted if $interrupted;
        exit 124 if $timed_out;
        exit (($status & 127) ? 128 + ($status & 127) : $status >> 8);
    }
    if ($done == -1) { kill 'KILL', -$pid; unlink $record if defined $record; exit 125 }
    my $now = _timeout_clock();
    if (!$timed_out && ($interrupted || $now >= $deadline)) {
        $timed_out = 1;
        kill 'TERM', -$pid;
        $kill_deadline = $now + $grace;
    }
    if ($timed_out && $now >= $kill_deadline) { kill 'KILL', -$pid }
    sleep 0.01;
}

#!/usr/bin/env python3
"""Closed synthetic commands. This module never consults real services/secrets."""
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys

root = Path(os.environ["HC_FIX"])
tool = Path(sys.argv[0]).name
args = sys.argv[1:]
settings = json.loads((root / "settings.json").read_text())
real_tools_file = root / "real-tools.json"
real_tools = json.loads(real_tools_file.read_text()) if real_tools_file.exists() else {}
if not isinstance(settings, dict):
    settings = {}
counts_path = root / (tool + ("-version-count" if args==["--version"] else "-count"))
count = int(counts_path.read_text()) + 1 if counts_path.exists() else 1
counts_path.write_text(str(count))
# Arguments for curl are safe to record only because the product must use stdin.
# Store a boolean sentinel oracle, never a copy of arbitrary inherited env values.
sentinels = ("fictional-notify-token", "fictional-chat", "fictional-other-secret",
             "fictional-access-sentinel", "fictional-refresh-sentinel")
safe_args = args.copy()
for sentinel in sentinels:
    safe_args = [a.replace(sentinel, "[sentinel]") for a in safe_args]
entry = {"tool": tool, "args": safe_args, "count": count,
         "source": os.environ.get("HC_TRACE_CALL", "harness"),
         "secret_in_env": any(s in v for v in os.environ.values() for s in sentinels),
         "secret_in_argv": any(s in a for a in args for s in sentinels)}
try:
    entry["mono_ms"] = int(float(Path(os.environ["HC_PROC"]).joinpath("uptime").read_text().split()[0])*1000)
except (KeyError, OSError, ValueError):
    entry["mono_ms"] = None
with (root / "calls.jsonl").open("a") as log:
    log.write(json.dumps(entry) + "\n")
hook = root / (tool + "-hook")
if tool=="curl" and settings.get("curl_ignore_term"):
    signal.signal(signal.SIGTERM,signal.SIG_IGN)
if hook.is_file():
    hook_env = os.environ.copy()
    hook_env["HC_TRACE_CALL"] = "fixture"
    result = subprocess.run([os.environ["HC_BASH"], str(hook), str(count), *args], env=hook_env)
    if result.returncode:
        sys.exit(result.returncode)

def reject():
    print("unexpected synthetic command shape: " + tool, file=sys.stderr)
    sys.exit(97)

if tool == "jq":
    if "--arg" in args and "op" in args:
        pos = args.index("op")
        marker = root / "jq-validation-fault-used"
        if args[pos+1] == "validate" and settings.get("jq_validate_once_rc") and not marker.exists():
            marker.touch()
            sys.exit(settings["jq_validate_once_rc"])
    os.execv(os.environ["HC_REAL_JQ"], [os.environ["HC_REAL_JQ"], *args])
elif tool == "date":
    if args != ["+%s"]:
        reject()
    print(settings.get("epoch_s", 2000000000))
elif tool == "systemctl":
    unit = json.loads((root / "unit.json").read_text())
    if args and args[0] == "show":
        allowed = {"show", "-p", "--property", "--value", "ActiveState", "ControlGroup", "InvocationID", "MainPID"}
        if any(a not in allowed and not a.startswith("agent-") and not a.startswith("--property=") for a in args):
            reject()
        if "--value" in args:
            keys = [a for a in args if a in unit]
            if len(keys) != 1:
                reject()
            print(unit[keys[0]])
        else:
            for key, value in unit.items():
                print(key + "=" + value)
        sys.exit(settings.get("systemctl_rc", 0))
    if args and args[0] == "is-active":
        sys.exit(0 if unit["ActiveState"] == "active" else 3)
    if args and args[0] == "is-failed":
        name = " ".join(args)
        key = "qmd_failed" if "qmd-watch" in name else "graph_failed"
        sys.exit(0 if settings.get(key, False) else 1)
    reject()
elif tool == "journalctl":
    if "-n" not in args or args[args.index("-n") + 1] != "2000" or "-10 min" not in args or "--no-pager" not in args:
        reject()
    sys.stdout.write((root / "journal").read_text())
    sys.exit(settings.get("journal_rc", 0))
elif tool == "ss":
    legacy = args == ["-tnpH", "state", "established"]
    general = args == ["-H", "-t", "-n", "-e", "state", "established"]
    if not legacy and not general and args != ["-H", "-t", "-n", "-e", "state", "established", "( dport = :443 )"]:
        reject()
    for row in json.loads((root / "sockets.json").read_text()):
        if legacy and row["state"] == "established":
            owner = 9999
            for process in Path(os.environ["HC_PROC"]).iterdir():
                fd = process / "fd/5"
                if process.name.isdecimal() and fd.is_symlink() and os.readlink(fd) == f'socket:[{row["inode"]}]':
                    owner = int(process.name)
            print(f'ESTAB 0 0 127.0.0.1:{row["local_port"]} 127.0.0.2:{row["remote_port"]} users:(("synthetic",pid={owner},fd=5)) ino:{row["inode"]}')
        elif not legacy and row["state"] == "established" and (general or row["remote_port"] == 443):
            print(f'0 0 127.0.0.1:{row["local_port"]} 127.0.0.2:{row["remote_port"]} ino:{row["inode"]} sk:0 cgroup:/synthetic')
    sys.exit(settings.get("ss_rc", 0))
elif tool == "sync":
    if args == ["--version"]:
        print(settings.get("sync_version", "sync (GNU coreutils) synthetic"))
        sys.exit(settings.get("sync_version_rc", 0))
    if len(args) != 1 or args[0].startswith("-"):
        reject()
    target = Path(args[0])
    if target.is_symlink() or not target.exists():
        reject()
    prior_path = root / "sync-prior.json"
    prior = json.loads(prior_path.read_text()) if prior_path.exists() else None
    kind = "dir" if target.is_dir() else "file"
    if kind == "dir":
        if not prior or prior["kind"] != "file" or prior["parent"] != str(target):
            reject()
    elif target.stat().st_mode & 0o777 != 0o600:
        reject()
    rc = settings.get("sync_fail_at", [])
    rc = 1 if count in rc else 0
    with (root / "sync-results.jsonl").open("a") as log:
        log.write(json.dumps({"count":count,"kind":kind,"rc":rc}) + "\n")
    if not rc:
        prior_path.write_text(json.dumps({"kind":kind,"parent":str(target.parent)}))
    sys.exit(rc)
elif tool == "mv":
    if len(args) != 2 or any(a.startswith("-") for a in args):
        reject()
    if count in settings.get("mv_fail_at", []):
        sys.exit(1)
    os.replace(*args)
elif tool == "curl":
    if not args or args[0] != "-q" or "--config" not in args or args[args.index("--config") + 1] != "-":
        reject()
    config = sys.stdin.read()
    try:
        values = []
        for line in config.splitlines():
            key, separator, encoded = line.partition("=")
            if not separator or key.strip() not in ("url", "data-urlencode"):
                raise ValueError("unexpected config key")
            values.append(json.loads(encoded.strip()))
    except (ValueError, TypeError):
        sys.exit(97)
    # Closed fixture values only: an unexpected real secret is never logged.
    try:
        os.fstat(9)
        fd9_open = True
    except OSError:
        fd9_open = False
    observed = {"fictional_token": "fictional-notify-token" in config,
                "fictional_chat": "fictional-chat" in config,
                "other_secret": "fictional-other-secret" in config,
                "fd9_open": fd9_open}
    event = re.search(r'\b(RECOVERY_WARN|WARN_EXPIRY|DEGRADED|RECOVERY)\b', config)
    observed["event"] = event.group(1) if event else None
    observed["health_warn"] = "health=WARN" in config
    observed["qmd_warning_in_text"] = "qmd watcher failed" in config
    observed["expiry_detail"] = "login renewal expiring in <1h" in config
    observed["escaped_chat_roundtrip"] = 'chat_id=fictional-chat"\\path' in values
    with (root / "transport.jsonl").open("a") as log:
        log.write(json.dumps(observed) + "\n")
    if "--output" not in args:
        reject()
    Path(args[args.index("--output") + 1]).write_text(settings.get("curl_body", '{"ok":true}'))
    sys.stdout.write(str(settings.get("curl_http", 200)))
    sys.exit(settings.get("curl_rc", 0))
else:
    if tool in real_tools:
        os.execv(real_tools[tool], [real_tools[tool], *args])
    reject()

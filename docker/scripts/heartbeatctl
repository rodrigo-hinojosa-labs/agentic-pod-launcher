#!/usr/bin/env bash
# heartbeatctl — inspect, control, and mutate the heartbeat.
# Image-baked, workspace-reading. Spec: docs/superpowers/specs/2026-04-19-*.md

set -u

# Overridable paths for tests.
WORKSPACE="${HEARTBEATCTL_WORKSPACE:-/workspace}"
HEARTBEAT_DIR="$WORKSPACE/scripts/heartbeat"
AGENT_YML="$WORKSPACE/agent.yml"
CONF_FILE="$HEARTBEAT_DIR/heartbeat.conf"
STATE_FILE="$HEARTBEAT_DIR/state.json"
RUNS_FILE="$HEARTBEAT_DIR/logs/runs.jsonl"
# Default: write the "desired" crontab to a workspace staging file.
# entrypoint.sh runs a root-privileged sync loop that copies it to
# /etc/crontabs/agent — busybox crond refuses to load crontabs not
# owned by root, so agent cannot write /etc/crontabs/ directly.
# Tests override HEARTBEATCTL_CRONTAB_FILE to a tmp path and inspect
# it directly (no sync loop needed in test context).
CRONTAB_FILE="${HEARTBEATCTL_CRONTAB_FILE:-$HEARTBEAT_DIR/.crontab.staging}"
LIB_DIR="${HEARTBEATCTL_LIB_DIR:-/opt/agent-admin/scripts/lib}"
# feature 012: qmd_index.sh + backup_vault.sh are canonical under the launcher's
# scripts/lib/ and only mirrored into docker/ (LIB_DIR) at scaffold/build. In the
# container LIB_DIR has them; from the launcher repo (host bats) it does not, so
# fall back to the relocated path so heartbeatctl still gets those helpers.
_HBCTL_RELOCATED_LIB="$(dirname "${BASH_SOURCE[0]}")/../../scripts/lib"

# shellcheck source=/dev/null
[ -f "$LIB_DIR/interval.sh" ] && source "$LIB_DIR/interval.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/state.sh" ]    && source "$LIB_DIR/state.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/backup_identity.sh" ] && source "$LIB_DIR/backup_identity.sh"
# shellcheck source=/dev/null
if [ -f "$LIB_DIR/backup_vault.sh" ]; then
  source "$LIB_DIR/backup_vault.sh"
elif [ -f "$_HBCTL_RELOCATED_LIB/backup_vault.sh" ]; then
  # shellcheck source=/dev/null
  source "$_HBCTL_RELOCATED_LIB/backup_vault.sh"
fi
# shellcheck source=/dev/null
[ -f "$LIB_DIR/backup_config.sh" ]   && source "$LIB_DIR/backup_config.sh"
# 046: the destination rule, the push credential, the privacy check and the unit
# locks (shared, non-committing). Without it every unit keeps its pre-046 path.
# shellcheck source=/dev/null
[ -f "$LIB_DIR/backup_dest.sh" ]     && source "$LIB_DIR/backup_dest.sh"
[ -f "$LIB_DIR/backup_main.sh" ]     && source "$LIB_DIR/backup_main.sh"
[ -f "$LIB_DIR/backup_pr.sh" ]       && source "$LIB_DIR/backup_pr.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/backup_memory.sh" ]   && source "$LIB_DIR/backup_memory.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/backup_history.sh" ]  && source "$LIB_DIR/backup_history.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/agent_repo.sh" ]      && source "$LIB_DIR/agent_repo.sh"
# shellcheck source=/dev/null
[ -f "$LIB_DIR/token_health.sh" ]    && source "$LIB_DIR/token_health.sh"
# shellcheck source=/dev/null
if [ -f "$LIB_DIR/qmd_index.sh" ]; then
  source "$LIB_DIR/qmd_index.sh"
elif [ -f "$_HBCTL_RELOCATED_LIB/qmd_index.sh" ]; then
  # shellcheck source=/dev/null
  source "$_HBCTL_RELOCATED_LIB/qmd_index.sh"
fi
# shellcheck source=/dev/null
if [ -f "$LIB_DIR/wiki_graph.sh" ]; then
  source "$LIB_DIR/wiki_graph.sh"
elif [ -f "$_HBCTL_RELOCATED_LIB/wiki_graph.sh" ]; then
  # shellcheck source=/dev/null
  source "$_HBCTL_RELOCATED_LIB/wiki_graph.sh"
fi

IDENTITY_STATE_DIR="${IDENTITY_STATE_DIR:-$WORKSPACE/.state}"
IDENTITY_BACKUP_STATE_FILE="$HEARTBEAT_DIR/identity-backup.json"
VAULT_BACKUP_STATE_FILE="$HEARTBEAT_DIR/vault-backup.json"
CONFIG_BACKUP_STATE_FILE="$HEARTBEAT_DIR/config-backup.json"
# 046: one heartbeat dir for the destination record, the unit state files and the
# unit locks; backup_dest.sh derives all of them from BACKUP_DEST_STATE_FILE.
MEMORY_BACKUP_STATE_FILE="$HEARTBEAT_DIR/memory-backup.json"
HISTORY_BACKUP_STATE_FILE="$HEARTBEAT_DIR/history-backup.json"
# The store tool (block-store.md). Host tests point it at the repo copy.
BACKUP_STORE_PY="${BACKUP_STORE_PY:-/opt/agent-admin/scripts/backup_store.py}"
BACKUP_DEST_STATE_FILE="$HEARTBEAT_DIR/backup-dest.json"
BACKUP_DEST_AGENT_YML="$AGENT_YML"
export BACKUP_DEST_STATE_FILE BACKUP_DEST_AGENT_YML
TOKEN_HEALTH_DIR="$HEARTBEAT_DIR/token-health"
# qmd_index.sh (sourced above) reads this for the reindex state file.
QMD_INDEX_STATE_FILE="${QMD_INDEX_STATE_FILE:-$HEARTBEAT_DIR/qmd-index.json}"
# wiki_graph.sh (014, sourced above) reads these for its state file + lock.
WIKI_GRAPH_STATE_FILE="${WIKI_GRAPH_STATE_FILE:-$HEARTBEAT_DIR/wiki-graph.json}"
WIKI_GRAPH_LOCK="${WIKI_GRAPH_LOCK:-$HEARTBEAT_DIR/.wiki-graph.lock}"
export WIKI_GRAPH_STATE_FILE WIKI_GRAPH_LOCK

cmd_help() {
  cat <<EOF
heartbeatctl — manage the agent heartbeat.

Read:
  status [--json]         Print human or machine-readable state.
  logs   [-n N] [--json]  Tail logs/runs.jsonl. Default N=20.
  show                    Dump heartbeat.conf + installed crontab + agent.yml section.

Control:
  test   [--prompt "..."] Run one heartbeat now (trigger=manual).
  pause                   Comment crontab line, set enabled=false in agent.yml.
  resume                  Inverse of pause.
  reload                  Re-read agent.yml, regenerate conf + crontab, SIGHUP crond.
  kick-channel            Force-respawn the tmux session when Telegram chat ghosts.
  drop-plugin   <spec>    Remove a plugin spec from agent.yml.plugins[]
                          (e.g. caveman@JuliusBrussee). Then kick-channel to apply.

Mutate (all atomic with rollback against agent.yml.prev):
  set-interval  <Nm|Nh>
  set-prompt    "<str>"     (or pipe via stdin with no arg)
  set-notifier  <none|log|telegram>
  set-timeout   <seconds>
  set-retries   <0..5>

Backup:
  backup-identity [--configure-key <pubkey>] [--disable] [--dry-run] [--gc]
                          Snapshot identity (pairing, plugin config, settings,
                          encrypted .env) to the 'backup/identity' branch on the
                          agent's repository (046) or its fork. The /login login
                          does not travel in any backup. Idempotent. See
                          docs/superpowers/specs/2026-04-22-identity-backup-design.md.
  backup-vault    [--dry-run] [--gc]
                          Snapshot the vault's markdown to the 'backup/vault'
                          branch. Excludes Obsidian per-device config (.obsidian/
                          workspace*.json, cache, .trash, sync-conflict files).
                          Idempotent via sha256 over content + filenames.
  backup-memory   [--dry-run]
                          (046) Snapshot the auto memory, claude-mem and the
                          backup.extra_paths to 'backup/memory' on the agent's
                          associated repository (encrypted where data-model
                          section 5 says). Repository only: never a fork.
  backup-history  [--dry-run]
                          (046) Snapshot the conversation history, always
                          encrypted, to 'backup/history'. Repository only.
  backup-status   [--json]
                          (046) Where each backup unit stands: destination,
                          credential (present or missing, never its value), key,
                          extra paths, caches and the work clone. Read-only.
  backup-config   [--dry-run] [--gc]
                          Snapshot agent.yml (plaintext config, no secrets) to
                          the 'backup/config' branch. On the agent's repository
                          (046) it also carries CLAUDE.md, personas/, the compose
                          override and the workspace .claude/ customizations
                          (encrypted for a sensitive agent; agent.yml always in
                          plaintext). Restored first by setup.sh
                          --restore-from-fork so the agent.yml is available
                          before the other units are pulled.

Token health:
  token-check             Probe configured token endpoints (GitHub PAT, Telegram
                          bot, Atlassian) and write state files to
                          scripts/heartbeat/token-health/. Cron-driven hourly;
                          this subcommand triggers an ad-hoc probe. Warnings
                          (debounced 24h) flow through the configured notifier.

Vault RAG:
  qmd-reindex   [--dry-run]
                          Reindex the vault's QMD semantic search if the vault
                          changed (flock-guarded + hash-debounced). Invoked by
                          the */5 cron backstop and the inotify watcher
                          (qmd_watch.sh). Opt-in via vault.qmd.enabled=true.
  qmd-migrate   [--dry-run|--force]
                          One-time move of the qmd collection to the 'wiki/'
                          mask (reuses embeddings). Idempotent: no-ops once
                          done. Runs automatically on the first reindex tick
                          after an upgrade; this is the manual trigger/check.
  wiki-graph              Regenerate the derived wiki graph + structural lint
                          (.graph/*.json + wiki-graph.json). flock-guarded, never
                          edits the wiki. Cron backstop + manual action. Opt-out
                          via vault.wiki_graph.enabled=false.

Review notice (opt-in, docker only):
  Weekly heartbeat tick that reports the actionability queue (review_due,
  project_overdue, pending_ingest, and more). Opt in via
  features.heartbeat.review.enabled=true in agent.yml, then `reload`. Default
  schedule "7 9 * * 1" (Mon 09:07); an invalid schedule WARNs and omits the
  line, leaving the rest of the crontab untouched.

Exit codes:
  0  success
  1  validation error
  2  operational error (filesystem, yq, crond)

Spec: docs/superpowers/specs/2026-04-19-heartbeat-observability-cli-design.md
EOF
}

cmd_show() {
  echo "=== heartbeat.conf ($CONF_FILE) ==="
  if [ -f "$CONF_FILE" ]; then cat "$CONF_FILE"; else echo "(missing)"; fi
  echo
  echo "=== crontab ($CRONTAB_FILE) ==="
  if [ -f "$CRONTAB_FILE" ]; then cat "$CRONTAB_FILE"; else echo "(missing)"; fi
  echo
  echo "=== agent.yml :: features.heartbeat + notifications ==="
  if [ -f "$AGENT_YML" ]; then
    yq '{"features": {"heartbeat": .features.heartbeat}, "notifications": .notifications}' "$AGENT_YML"
  else
    echo "(missing)"
  fi
}

# Read a key from agent.yml, returning empty string on missing/null.
# Distinguishes "yq parsed OK but path is missing/null" (silent — caller
# falls back to its `// "default"`) from "yq itself errored" (loud — the
# yml is malformed and the user needs to know).
_yq() {
  local out err_log
  err_log=$(mktemp)
  if ! out=$(yq "${1}" "$AGENT_YML" 2>"$err_log"); then
    echo "heartbeatctl: yq failed reading '${1}' from $AGENT_YML:" >&2
    cat "$err_log" >&2
    rm -f "$err_log"
    return 1
  fi
  rm -f "$err_log"
  printf '%s' "$out" | sed 's/^null$//'
}

# 037: cron-field validators for features.heartbeat.review.schedule. A plain
# integer/range/list check per field -- no interval math, so busybox `awk`/
# `date` quirks never enter it.
_v_cron5_num() {
  local n="$1" min="$2" max="$3"
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  [ "$n" -ge "$min" ] && [ "$n" -le "$max" ]
}

_v_cron5_piece() {
  local piece="$1" min="$2" max="$3" lo hi
  if [[ "$piece" == *-* ]]; then
    lo="${piece%%-*}"; hi="${piece#*-}"
    _v_cron5_num "$lo" "$min" "$max" || return 1
    _v_cron5_num "$hi" "$min" "$max" || return 1
    [ "$lo" -le "$hi" ]
  else
    _v_cron5_num "$piece" "$min" "$max"
  fi
}

# _v_cron5_field VALUE MIN MAX ALLOW_STAR -- ALLOW_STAR=0 rejects `*` and
# `*/N` (the minute field: a review notice must fire at most once a week, and
# `*`/`*/N` there would fire every tick instead, SC-007).
_v_cron5_field() {
  local value="$1" min="$2" max="$3" allow_star="$4"
  if [ "$value" = "*" ]; then
    [ "$allow_star" = "1" ]
    return $?
  fi
  if [[ "$value" =~ ^\*/([0-9]+)$ ]]; then
    [ "$allow_star" = "1" ] || return 1
    [ "${BASH_REMATCH[1]}" -ge 1 ] 2>/dev/null
    return $?
  fi
  local piece
  local IFS=','
  # deliberate comma-split of a cron field
  # shellcheck disable=SC2206
  local -a pieces=($value)
  unset IFS
  [ "${#pieces[@]}" -ge 1 ] || return 1
  for piece in "${pieces[@]}"; do
    [ -n "$piece" ] || return 1
    _v_cron5_piece "$piece" "$min" "$max" || return 1
  done
  return 0
}

# _v_cron5 SCHEDULE -- 5 space-separated fields, minute without `*`/`*/N`.
_v_cron5() {
  local sched="$1"
  local -a f
  IFS=' ' read -r -a f <<< "$sched"
  [ "${#f[@]}" -eq 5 ] || return 1
  _v_cron5_field "${f[0]}" 0 59 0 || return 1
  _v_cron5_field "${f[1]}" 0 23 1 || return 1
  _v_cron5_field "${f[2]}" 1 31 1 || return 1
  _v_cron5_field "${f[3]}" 1 12 1 || return 1
  _v_cron5_field "${f[4]}" 0 7 1
}

# 046: a five-field schedule where `*` and `*/N` are allowed in every field, the
# minute included (U7), unlike _v_cron5 (the weekly review notice).
_v_cron5_any() {
  local sched="$1"
  local -a f
  IFS=' ' read -r -a f <<< "$sched"
  [ "${#f[@]}" -eq 5 ] || return 1
  _v_cron5_field "${f[0]}" 0 59 1 || return 1
  _v_cron5_field "${f[1]}" 0 23 1 || return 1
  _v_cron5_field "${f[2]}" 1 31 1 || return 1
  _v_cron5_field "${f[3]}" 1 12 1 || return 1
  _v_cron5_field "${f[4]}" 0 7 1
}

# 037: default weekly-review prompt text, localized (molde voice_signoff_default,
# feature 034; mixed -> spanish). Placeholders {{VAULT_DIR}}/{{WORKSPACE}} are
# substituted by the caller. No accented characters by design (heredoc -> yq ->
# crontab file; same byte discipline as 033/034).
heartbeat_review_prompt_default() {
  local lang="$1"
  case "$lang" in
    en)
      printf '%s' 'Weekly vault review notice. Read with the Read tool the files {{VAULT_DIR}}/.graph/findings.json and {{WORKSPACE}}/scripts/heartbeat/wiki-graph.json. Do not use any other tool and do not write anything. Reply in plain text, no markdown, under 600 characters: one line for each nonzero counter among review_due, project_overdue, project_incomplete, pending_ingest, archive_candidate, schema_delta_pending and problem_unfed, then at most three items (page and detail), most overdue first. If every count is zero, reply exactly: nothing pending'
      ;;
    *)
      printf '%s' 'Aviso semanal de revision del vault. Lee con la herramienta Read los archivos {{VAULT_DIR}}/.graph/findings.json y {{WORKSPACE}}/scripts/heartbeat/wiki-graph.json. No uses ninguna otra herramienta y no escribas nada. Responde en texto plano, sin markdown, en menos de 600 caracteres: una linea por cada contador distinto de cero entre review_due, project_overdue, project_incomplete, pending_ingest, archive_candidate, schema_delta_pending y problem_unfed, y luego a lo mas tres items (pagina y detalle), los mas atrasados primero. Si todos los contadores son cero, responde exactamente: sin pendientes'
      ;;
  esac
}

cmd_reload() {
  [ -f "$AGENT_YML" ] || { echo "heartbeatctl: $AGENT_YML missing" >&2; return 2; }

  local enabled interval timeout retries prompt channel cron
  # Use shell-level default for 'enabled' so yq boolean false is preserved
  enabled=$(_yq '.features.heartbeat.enabled')
  [ -z "$enabled" ] && enabled="true"
  interval=$(_yq '.features.heartbeat.interval // "30m"')
  timeout=$(_yq '.features.heartbeat.timeout // 300')
  retries=$(_yq '.features.heartbeat.retries // 1')
  prompt=$(_yq '.features.heartbeat.default_prompt // "Status check — return a short plain-text report (uptime, notable issues). No tool use; your stdout is forwarded verbatim to the notifier."')
  channel=$(_yq '.notifications.channel // "none"')

  # Validate + derive cron
  if ! cron=$(interval_to_cron "$interval" 2>&1); then
    echo "heartbeatctl: $cron" >&2
    return 1
  fi

  # Ensure destination dirs exist
  mkdir -p "$HEARTBEAT_DIR/logs"

  # Rewrite heartbeat.conf atomically
  local tmp_conf
  tmp_conf=$(mktemp)
  cat > "$tmp_conf" <<CONF
# Heartbeat — generated by \`heartbeatctl reload\`. Do not edit by hand.
HEARTBEAT_ENABLED="$enabled"
HEARTBEAT_INTERVAL="$interval"
HEARTBEAT_CRON="$cron"
HEARTBEAT_TIMEOUT="$timeout"
HEARTBEAT_RETRIES="$retries"
NOTIFY_SUCCESS_EVERY="1"
HEARTBEAT_PROMPT="$(printf '%s' "$prompt" | sed 's/"/\\"/g')"
NOTIFY_CHANNEL="$channel"
NOTIFY_BOT_TOKEN="\${NOTIFY_BOT_TOKEN:-}"
NOTIFY_CHAT_ID="\${NOTIFY_CHAT_ID:-}"
CONF
  if ! mv -f "$tmp_conf" "$CONF_FILE"; then
    rm -f "$tmp_conf"
    echo "heartbeatctl: failed to install $CONF_FILE" >&2
    return 2
  fi

  # Rewrite crontab atomically via tmp+mv on the same directory.
  # The default $CRONTAB_FILE is the workspace staging path
  # (.crontab.staging), which is agent-owned, so a sibling tmp file
  # is writable. The root-side sync loop in entrypoint.sh reads this
  # via cmp -s — without tmp+mv, a concurrent reader could observe a
  # partially-written file and copy garbage into /etc/crontabs/.
  local line
  if [ "$enabled" = "true" ]; then
    line="$cron /workspace/scripts/heartbeat/heartbeat.sh >> /workspace/scripts/heartbeat/logs/cron.log 2>&1"
  else
    line="# paused: $cron /workspace/scripts/heartbeat/heartbeat.sh >> /workspace/scripts/heartbeat/logs/cron.log 2>&1"
  fi
  # Optional second crontab line for scheduled identity backup
  local backup_line=""
  local bi_enabled bi_schedule
  bi_enabled=$(_yq '.features.identity_backup.enabled')
  bi_schedule=$(_yq '.features.identity_backup.schedule // "30 3 * * *"')
  # 046 (U7, D20): with an associated repository the daily line exists unless the
  # operator disabled it explicitly; with a fork or no destination, only when it
  # is true, as before.
  local bi_dest="none"
  if command -v backup_dest_resolve > /dev/null 2>&1; then
    bi_dest=$(backup_dest_resolve "$AGENT_YML")
    bi_dest="${bi_dest%%$'\t'*}"
  fi
  if [ "$bi_dest" = "repo" ]; then
    if [ "$bi_enabled" != "false" ]; then
      backup_line="$bi_schedule /usr/local/bin/heartbeatctl backup-identity >> /workspace/scripts/heartbeat/logs/backup-identity.log 2>&1"
    fi
  elif [ "$bi_enabled" = "true" ]; then
    backup_line="$bi_schedule /usr/local/bin/heartbeatctl backup-identity >> /workspace/scripts/heartbeat/logs/backup-identity.log 2>&1"
  fi

  # Optional third crontab line for scheduled vault backup. Default
  # cadence is hourly because the vault is the agent's working data
  # and changes much faster than identity (which is roughly static
  # post-setup). Override via vault.backup_schedule in agent.yml.
  local vault_backup_line=""
  local vault_enabled vault_backup_schedule
  vault_enabled=$(_yq '.vault.enabled')
  vault_backup_schedule=$(_yq '.vault.backup_schedule // "0 * * * *"')
  if [ "$vault_enabled" = "true" ]; then
    vault_backup_line="$vault_backup_schedule /usr/local/bin/heartbeatctl backup-vault >> /workspace/scripts/heartbeat/logs/backup-vault.log 2>&1"
  fi

  # Optional fourth crontab line for scheduled config backup. Same
  # cadence as identity (daily 03:30) because agent.yml only changes
  # via setup.sh --regenerate. Set features.config_backup.enabled=false
  # in agent.yml to opt out.
  local config_backup_line=""
  local cfg_enabled cfg_schedule
  cfg_enabled=$(_yq '.features.config_backup.enabled')
  [ -z "$cfg_enabled" ] && cfg_enabled="true"
  cfg_schedule=$(_yq '.features.config_backup.schedule // "30 3 * * *"')
  if [ "$cfg_enabled" = "true" ]; then
    config_backup_line="$cfg_schedule /usr/local/bin/heartbeatctl backup-config >> /workspace/scripts/heartbeat/logs/backup-config.log 2>&1"
  fi

  # Optional fifth crontab line for hourly token-health probe. Default
  # cadence is once per hour because GitHub/Telegram/Atlassian tokens
  # rarely change state — hourly catches expiry within an hour without
  # spamming free-tier rate limits. Opt out via
  # features.token_health.enabled=false.
  local token_health_line=""
  local th_enabled th_schedule
  th_enabled=$(_yq '.features.token_health.enabled')
  [ -z "$th_enabled" ] && th_enabled="true"
  th_schedule=$(_yq '.features.token_health.schedule // "0 * * * *"')
  if [ "$th_enabled" = "true" ]; then
    token_health_line="$th_schedule /opt/agent-admin/scripts/check_token_health.sh >> /workspace/scripts/heartbeat/logs/token-health.log 2>&1"
  fi

  # Optional sixth crontab line: QMD reindex backstop. The inotify watcher
  # (qmd_watch.sh) handles immediacy; this cron line guarantees freshness if
  # the watcher died or missed an event. Both call the same flock-guarded
  # `qmd-reindex`, so they never overlap. Default */5; opt out by
  # vault.qmd.enabled=false. Override cadence via vault.qmd.schedule.
  local qmd_reindex_line=""
  local qmd_enabled qmd_schedule
  qmd_enabled=$(_yq '.vault.qmd.enabled')
  qmd_schedule=$(_yq '.vault.qmd.schedule // "*/5 * * * *"')
  if [ "$qmd_enabled" = "true" ]; then
    qmd_reindex_line="$qmd_schedule /usr/local/bin/heartbeatctl qmd-reindex >> /workspace/scripts/heartbeat/logs/qmd-reindex.log 2>&1"
  fi

  # Seventh crontab line: wiki-graph runner backstop (014). Derives the graph +
  # structural lint. Default-on when the vault is on (opt out via
  # vault.wiki_graph.enabled=false). Default cadence 20 */6; override via
  # vault.wiki_graph.schedule. Same flock-guarded command as the manual action.
  local wiki_graph_line=""
  local wg_vault_en wg_en wg_schedule
  wg_vault_en=$(_yq '.vault.enabled')
  wg_en=$(_yq '.vault.wiki_graph.enabled')
  wg_schedule=$(_yq '.vault.wiki_graph.schedule // "20 */6 * * *"')
  if [ "$wg_vault_en" = "true" ] && [ "$wg_en" != "false" ]; then
    wiki_graph_line="$wg_schedule /usr/local/bin/heartbeatctl wiki-graph >> /workspace/scripts/heartbeat/logs/wiki-graph.log 2>&1"
  fi

  # 037: opt-in weekly review notice. Concatenated onto the SAME heredoc slot
  # as wiki_graph_line (not its own heredoc line) so a disabled/unconfigured
  # feature keeps the crontab byte-identical to pre-037 (refutación N C1) --
  # an own blank line would show up even when review_line is empty.
  local review_line=""
  local review_enabled review_schedule review_prompt
  review_enabled=$(_yq '.features.heartbeat.review.enabled')
  review_schedule=$(_yq '.features.heartbeat.review.schedule // "7 9 * * 1"')
  review_prompt=$(_yq '.features.heartbeat.review.prompt // ""')
  if [ "$review_enabled" = "true" ]; then
    if _v_cron5 "$review_schedule"; then
      local review_prompt_effective review_vault_root review_lang
      if [ -n "$review_prompt" ]; then
        review_prompt_effective="$review_prompt"
      else
        review_lang=$(_yq '.user.language // "es"')
        review_prompt_effective=$(heartbeat_review_prompt_default "$review_lang")
      fi
      review_vault_root=$(command -v vault_resolve_root >/dev/null 2>&1 && vault_resolve_root "$AGENT_YML" 2>/dev/null || true)
      # Filesystem paths and /workspace never contain '&' -- the ampersand
      # hazard in bash 5.2+ `${//}` (023-fix-render-ampersand) doesn't apply
      # to this substitution's domain.
      review_prompt_effective="${review_prompt_effective//\{\{VAULT_DIR\}\}/$review_vault_root}"
      review_prompt_effective="${review_prompt_effective//\{\{WORKSPACE\}\}//workspace}"
      local tmp_review
      tmp_review=$(mktemp)
      printf '%s' "$review_prompt_effective" > "$tmp_review"
      mv -f "$tmp_review" "$HEARTBEAT_DIR/review-prompt.txt"
      review_line=$'\n'"$review_schedule HEARTBEAT_TRIGGER=review /workspace/scripts/heartbeat/heartbeat.sh --trigger review --prompt \"\$(cat /workspace/scripts/heartbeat/review-prompt.txt)\" >> /workspace/scripts/heartbeat/logs/review.log 2>&1"
    else
      echo "heartbeatctl: WARN invalid features.heartbeat.review.schedule — review notice line omitted" >&2
    fi
  fi

  # 046 (U7): the memory and history lines, only with an associated repository,
  # an enabled unit and a valid five-field schedule (`*` and `*/N` allowed in every
  # field, the minute included). Concatenated onto the last heredoc slot, like
  # review_line, so a crontab without them does not gain even a blank line.
  local repo_units_line=""
  if [ "$bi_dest" = "repo" ]; then
    local _ru _ru_en _ru_sched
    for _ru in memory history; do
      _ru_en=$(_yq ".features.${_ru}_backup.enabled")
      [ "$_ru_en" = "false" ] && continue
      if [ "$_ru" = "memory" ]; then
        _ru_sched=$(_yq '.features.memory_backup.schedule // "40 3 * * *"')
      else
        _ru_sched=$(_yq '.features.history_backup.schedule // "50 3 * * *"')
      fi
      if _v_cron5_any "$_ru_sched"; then
        repo_units_line="${repo_units_line}"$'\n'"$_ru_sched /usr/local/bin/heartbeatctl backup-$_ru >> /workspace/scripts/heartbeat/logs/backup-$_ru.log 2>&1"
      else
        echo "heartbeatctl: WARN invalid features.${_ru}_backup.schedule — backup-$_ru line omitted" >&2
      fi
    done
  fi

  local tmp_crontab="${CRONTAB_FILE}.tmp"
  if ! cat > "$tmp_crontab" <<CT
# Cron for in-container agent heartbeat + identity/vault/config backup + token-health + qmd reindex + wiki-graph. Managed by heartbeatctl.
$line
${backup_line}
${vault_backup_line}
${config_backup_line}
${token_health_line}
${qmd_reindex_line}
${wiki_graph_line}${review_line}${repo_units_line}
CT
  then
    rm -f "$tmp_crontab"
    echo "heartbeatctl: failed to write $tmp_crontab" >&2
    return 2
  fi
  if ! mv -f "$tmp_crontab" "$CRONTAB_FILE"; then
    rm -f "$tmp_crontab"
    echo "heartbeatctl: failed to install $CRONTAB_FILE" >&2
    return 2
  fi

  # Do NOT SIGHUP busybox crond — unlike vixie/cronie, busybox crond
  # terminates on SIGHUP instead of reloading. Its scheduler rechecks
  # crontab mtimes on every minute tick and picks up changes on its own.
  # Expected lag to first tick with the new schedule: up to 60 seconds.

  echo "heartbeatctl: reloaded (interval=$interval cron='$cron' enabled=$enabled channel=$channel)"
}

_crond_pid() {
  # Best-effort: return pid of crond, empty if not running
  pgrep -x crond 2>/dev/null | head -1
}

_enrich_state() {
  # Read state.json, overlay crond {alive,pid}, emit to stdout
  local state_raw
  state_raw=$(cat "$STATE_FILE" 2>/dev/null || echo '{}')
  local pid alive
  pid=$(_crond_pid)
  if [ -n "$pid" ]; then alive=true; else alive=false; fi
  printf '%s' "$state_raw" | jq -c --arg pid "$pid" --argjson alive "$alive" '
    .crond = {alive:$alive, pid:($pid | if . == "" then null else tonumber end)}
  '
}

cmd_status() {
  [ -f "$STATE_FILE" ] || { echo "heartbeatctl: $STATE_FILE missing — has the heartbeat ever run? try 'heartbeatctl reload'" >&2; return 2; }
  local schema
  schema=$(jq -r '.schema // 0' "$STATE_FILE" 2>/dev/null || echo 0)
  if [ "$schema" != "1" ]; then
    echo "heartbeatctl: unknown state.json schema '$schema' — refusing to parse" >&2
    return 1
  fi

  local enriched
  enriched=$(_enrich_state)

  if [ "${1:-}" = "--json" ]; then
    printf '%s\n' "$enriched"
    return 0
  fi

  # Pretty
  printf '%s' "$enriched" | jq -r '
    "heartbeat: " + (if .enabled then "ENABLED" else "PAUSED" end)
    + "\n  interval: " + .interval + "   cron: " + .cron
    + "\n  prompt:   " + (.prompt | .[0:120] + (if length > 120 then "…" else "" end))
    + "\n  notifier: " + .notifier_channel
    + "\n  last run: " + .last_run.status + "  @ " + .last_run.ts + "  (" + (.last_run.duration_ms|tostring) + "ms, attempt " + (.last_run.attempt|tostring) + ")"
    + "\n  counters: runs=" + (.counters.total_runs|tostring)
      + " ok=" + (.counters.ok|tostring)
      + " timeout=" + (.counters.timeout|tostring)
      + " error=" + (.counters.error|tostring)
      + " streak_fail=" + (.counters.consecutive_failures|tostring)
      + (if .counters.success_rate_24h then "  24h=" + ((.counters.success_rate_24h*100|floor)|tostring) + "%" else "" end)
    + "\n  crond:    " + (if .crond.alive then "alive (pid " + (.crond.pid|tostring) + ")" else "DOWN" end)
    + "\n  updated:  " + .updated_at'
  echo

  # Tail of last 5 runs
  if [ -f "$RUNS_FILE" ]; then
    echo "recent runs:"
    tail -5 "$RUNS_FILE" | jq -r '"  " + .ts + "  " + .status + "  " + (.duration_ms|tostring) + "ms  " + (.prompt | .[0:60])'
  fi

  # Identity backup summary (non-fatal if state file missing)
  if [ -f "$IDENTITY_BACKUP_STATE_FILE" ]; then
    local bi_mode bi_commit bi_push
    bi_mode=$(jq -r '.mode // ""' "$IDENTITY_BACKUP_STATE_FILE" 2>/dev/null)
    bi_commit=$(jq -r '.last_commit // ""' "$IDENTITY_BACKUP_STATE_FILE" 2>/dev/null)
    bi_push=$(jq -r '.last_push // ""' "$IDENTITY_BACKUP_STATE_FILE" 2>/dev/null)
    echo
    echo "identity backup: mode=${bi_mode:-unknown} commit=${bi_commit:0:8} last_push=${bi_push:-never}"
    if [ "$bi_mode" = "partial" ]; then
      echo "  ⚠ partial mode — .env not encrypted. Run:"
      echo "    heartbeatctl backup-identity --configure-key <path|pubkey>"
    fi
  fi

  # Vault backup summary (no mode field — vault is plaintext markdown).
  if [ -f "$VAULT_BACKUP_STATE_FILE" ]; then
    local bv_commit bv_push
    bv_commit=$(jq -r '.last_commit // ""' "$VAULT_BACKUP_STATE_FILE" 2>/dev/null)
    bv_push=$(jq -r '.last_push // ""' "$VAULT_BACKUP_STATE_FILE" 2>/dev/null)
    echo "vault backup:    commit=${bv_commit:0:8} last_push=${bv_push:-never}"
  fi

  # Config backup summary (also plaintext: agent.yml).
  if [ -f "$CONFIG_BACKUP_STATE_FILE" ]; then
    local bc_commit bc_push
    bc_commit=$(jq -r '.last_commit // ""' "$CONFIG_BACKUP_STATE_FILE" 2>/dev/null)
    bc_push=$(jq -r '.last_push // ""' "$CONFIG_BACKUP_STATE_FILE" 2>/dev/null)
    echo "config backup:   commit=${bc_commit:0:8} last_push=${bc_push:-never}"
  fi

  # 037: wiki-graph review-queue summary — the seven canonical counters, same
  # names/order as the local agentctl surface (data-model.md §6).
  if [ -f "$WIKI_GRAPH_STATE_FILE" ] && command -v jq >/dev/null 2>&1; then
    local wg_status wg_run wg_due wg_overdue wg_incomplete wg_ingest wg_archive wg_delta wg_unfed
    wg_status=$(jq -r '.last_status // "unknown"' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_run=$(jq -r '.last_run // "never"' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_due=$(jq -r '.counts.review_due // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_overdue=$(jq -r '.counts.project_overdue // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_incomplete=$(jq -r '.counts.project_incomplete // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_ingest=$(jq -r '.counts.pending_ingest // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_archive=$(jq -r '.counts.archive_candidate // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_delta=$(jq -r '.counts.schema_delta_pending // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    wg_unfed=$(jq -r '.counts.problem_unfed // 0' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null)
    echo
    echo "wiki-graph: $wg_status @ $wg_run — due=$wg_due overdue=$wg_overdue incomplete=$wg_incomplete ingest=$wg_ingest archive=$wg_archive delta=$wg_delta unfed=$wg_unfed"
  fi

  # 037: qmd index summary — collection layout/migration computed LIVE (not
  # just read from the state file) so `pending` is visible before the first
  # reindex tick ever runs (data-model.md §8; M U2).
  if command -v qmd_collection_migration_state >/dev/null 2>&1; then
    local qi_status="unknown" qi_pending="unknown"
    if [ -f "$QMD_INDEX_STATE_FILE" ]; then
      qi_status=$(jq -r '.last_status // "unknown"' "$QMD_INDEX_STATE_FILE" 2>/dev/null)
      qi_pending=$(jq -r '.pending // "unknown"' "$QMD_INDEX_STATE_FILE" 2>/dev/null)
    fi
    echo
    echo "qmd index: $qi_status pending=$qi_pending collection=$(qmd_collection_layout) migration=$(qmd_collection_migration_state)"
  fi

  # Token-health summary (one line per probed token). Emits nothing
  # when no probes have run yet (first hour after a fresh boot).
  if [ -d "$TOKEN_HEALTH_DIR" ]; then
    local th_file emitted=0
    for th_file in "$TOKEN_HEALTH_DIR"/*.json; do
      [ -f "$th_file" ] || continue
      [ "$emitted" -eq 0 ] && { echo; echo "token health:"; emitted=1; }
      local th_id th_status th_check th_lat th_err
      th_id=$(jq -r '.id // ""'         "$th_file" 2>/dev/null)
      th_status=$(jq -r '.status // ""' "$th_file" 2>/dev/null)
      th_check=$(jq -r '.last_check // ""' "$th_file" 2>/dev/null)
      th_lat=$(jq -r '.latency_ms // 0' "$th_file" 2>/dev/null)
      th_err=$(jq -r '.error // ""'     "$th_file" 2>/dev/null)
      printf '  %-22s %-9s last_check=%s lat=%sms%s\n' \
        "$th_id" "$th_status" "${th_check:-never}" "$th_lat" \
        "$([ -n "$th_err" ] && [ "$th_err" != "null" ] && printf ' err=%s' "$th_err")"
    done
  fi
}

cmd_logs() {
  local n=20 json=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n) n="$2"; shift 2 ;;
      --json) json=true; shift ;;
      *) echo "logs: unknown flag '$1'" >&2; return 1 ;;
    esac
  done
  [ -f "$RUNS_FILE" ] || { echo "heartbeatctl: no runs yet"; return 0; }
  if [ "$json" = true ]; then
    tail -n "$n" "$RUNS_FILE"
  else
    printf '%-21s  %-8s  %-7s  %-5s  %s\n' "TS" "STATUS" "DUR" "ATTMPT" "PROMPT"
    tail -n "$n" "$RUNS_FILE" | jq -r '
      [.ts, .status, ((.duration_ms|tostring)+"ms"), (.attempt|tostring), (.prompt|.[0:60])]
      | @tsv' | awk -F'\t' '{printf "%-21s  %-8s  %-7s  %-5s  %s\n", $1,$2,$3,$4,$5}'
  fi
}

cmd_pause() {
  local prev; prev="$AGENT_YML.prev"
  cp "$AGENT_YML" "$prev"
  yq -i '.features.heartbeat.enabled = false' "$AGENT_YML" || {
    cp "$prev" "$AGENT_YML"; rm -f "$prev"; echo "pause: yq failed" >&2; return 2
  }
  if ! cmd_reload; then
    cp "$prev" "$AGENT_YML"; rm -f "$prev"
    cmd_reload >/dev/null 2>&1 || true
    return 2
  fi
  rm -f "$prev"
  echo "heartbeatctl: paused"
}

cmd_resume() {
  local prev; prev="$AGENT_YML.prev"
  cp "$AGENT_YML" "$prev"
  yq -i '.features.heartbeat.enabled = true' "$AGENT_YML" || {
    cp "$prev" "$AGENT_YML"; rm -f "$prev"; echo "resume: yq failed" >&2; return 2
  }
  if ! cmd_reload; then
    cp "$prev" "$AGENT_YML"; rm -f "$prev"
    cmd_reload >/dev/null 2>&1 || true
    return 2
  fi
  rm -f "$prev"
  echo "heartbeatctl: resumed"
}

# _mutate EXPR VALIDATOR VALUE
# Runs validator(value) first; if 0, backs up agent.yml, applies yq -i EXPR,
# runs reload, and on any failure restores agent.yml and reloads with the
# prior state. EXPR uses strenv(V) to read the value.
_mutate() {
  local expr="$1" validator="$2" value="$3"
  if ! "$validator" "$value"; then return 1; fi
  local prev="$AGENT_YML.prev"
  cp "$AGENT_YML" "$prev"
  if ! V="$value" yq -i "$expr" "$AGENT_YML"; then
    cp "$prev" "$AGENT_YML"; rm -f "$prev"
    echo "heartbeatctl: yq mutation failed" >&2; return 2
  fi
  if ! cmd_reload; then
    cp "$prev" "$AGENT_YML"; rm -f "$prev"
    cmd_reload >/dev/null 2>&1 || true
    echo "heartbeatctl: reload failed after mutation — rolled back" >&2
    return 2
  fi
  rm -f "$prev"
}

_v_interval() {
  interval_to_cron "$1" >/dev/null 2>&1 || { echo "invalid interval: $1 (see 'heartbeatctl help')" >&2; return 1; }
}
_v_notifier() {
  case "$1" in none|log|telegram) return 0 ;;
    *) echo "invalid notifier: $1 (none|log|telegram)" >&2; return 1 ;;
  esac
}
_v_timeout() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] && [ "$1" -ge 10 ] || { echo "timeout must be integer >= 10" >&2; return 1; }
}
_v_retries() {
  [[ "$1" =~ ^[0-5]$ ]] || { echo "retries must be integer 0..5" >&2; return 1; }
}
_v_prompt() {
  local len=${#1}
  [ "$len" -gt 0 ] && [ "$len" -le 4000 ] || { echo "prompt must be 1..4000 chars" >&2; return 1; }
}

cmd_set_interval() { _mutate '.features.heartbeat.interval = strenv(V)' _v_interval "$1"; }
cmd_set_notifier() { _mutate '.notifications.channel = strenv(V)'     _v_notifier "$1"; }
cmd_set_timeout()  { _mutate '.features.heartbeat.timeout = (strenv(V)|tonumber)' _v_timeout "$1"; }
cmd_set_retries()  { _mutate '.features.heartbeat.retries = (strenv(V)|tonumber)' _v_retries "$1"; }

cmd_set_prompt() {
  local v="${1:-}"
  if [ -z "$v" ] && [ ! -t 0 ]; then v=$(cat); fi
  _mutate '.features.heartbeat.default_prompt = strenv(V)' _v_prompt "$v"
  # Warn if telegram without secrets
  if [ "$(yq -r '.notifications.channel' "$AGENT_YML")" = "telegram" ]; then
    if ! grep -q '^NOTIFY_BOT_TOKEN=' "$WORKSPACE/.env" 2>/dev/null || \
       ! grep -q '^NOTIFY_CHAT_ID=' "$WORKSPACE/.env" 2>/dev/null; then
      echo "heartbeatctl: WARN — notifications.channel=telegram but .env missing NOTIFY_BOT_TOKEN/NOTIFY_CHAT_ID" >&2
    fi
  fi
}

cmd_test() {
  local prompt=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --prompt) prompt="$2"; shift 2 ;;
      *) echo "test: unknown flag '$1'" >&2; return 1 ;;
    esac
  done
  local runner="$HEARTBEAT_DIR/heartbeat.sh"
  [ -x "$runner" ] || { echo "heartbeatctl: $runner missing or not executable" >&2; return 2; }
  HEARTBEAT_TRIGGER=manual \
  HEARTBEAT_STATE_LIB="${HEARTBEAT_STATE_LIB:-$LIB_DIR/state.sh}" \
    bash "$runner" ${prompt:+--prompt "$prompt"}
}

# kick-channel — force-respawn the tmux session when the Telegram plugin
# stops forwarding messages to claude. The bug is upstream in the MCP
# stdio routing between claude-plugins-official/telegram and claude
# itself: bun stays alive and keeps polling Telegram, but its
# `notifications/claude/channel` messages don't reach the session.
# This command kills the tmux session; start_services.sh watchdog
# respawns it within ~2 seconds with a fresh plugin attachment.
cmd_backup_identity() {
  local mode="run"
  local configure_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --configure-key) shift; configure_key="${1:-}"; mode="configure"; shift ;;
      --disable)       mode="disable"; shift ;;
      --dry-run)       mode="dry-run"; shift ;;
      --gc)            mode="gc"; shift ;;
      -h|--help)
        cat <<EOF
Usage: heartbeatctl backup-identity [flags]

Flags:
  --configure-key <path|pubkey-string>   Set backup.identity.recipient, trigger backup.
  --disable                              Set features.identity_backup.enabled=false.
  --dry-run                              Stage + diff without push.
  --gc                                   Run 'git gc' on the local clone before push.
  (no flags)                             Default: run the backup primitive.
EOF
        return 0 ;;
      *) echo "backup-identity: unknown flag: $1" >&2; return 1 ;;
    esac
  done

  [ -d "$IDENTITY_STATE_DIR" ] || {
    echo "backup-identity: no state dir at $IDENTITY_STATE_DIR — nothing to back up yet"
    return 0
  }

  case "$mode" in
    run)        _bi_run ;;
    configure)  _bi_configure_key "$configure_key" ;;
    disable)    _bi_disable ;;
    dry-run)    _bi_run --dry-run ;;
    gc)         _bi_gc_then_run ;;
  esac
}

_bi_run() {
  local dry_run=0
  [ "${1:-}" = "--dry-run" ] && dry_run=1

  local any=0 path
  while IFS= read -r path; do
    [ -e "$IDENTITY_STATE_DIR/$path" ] && { any=1; break; }
  done < <(identity_whitelist "$IDENTITY_STATE_DIR")
  if [ "$any" -eq 0 ]; then
    echo "backup-identity: no identity files yet, skipping"
    return 0
  fi

  # 046: with an associated repository, the repo path (U1). The rest of this
  # function is the fork / no-destination path, unchanged.
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    _bi_run_repo "$_dest_url" "$dry_run"
    return $?
  fi

  local fork_url recipient
  fork_url=$(_yq '.scaffold.fork.url')
  recipient=$(_yq '.backup.identity.recipient')
  [ "$recipient" = "null" ] && recipient=""

  local current_hash last_hash
  current_hash=$(identity_hash "$IDENTITY_STATE_DIR" "$recipient")
  last_hash=$(identity_last_hash "$IDENTITY_BACKUP_STATE_FILE")

  if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
    echo "backup-identity: no changes since last backup (hash $last_hash)"
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "backup-identity: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    return 0
  fi

  if [ -z "$fork_url" ]; then
    echo "backup-identity: agent.yml has no scaffold.fork.url — fork-less agent, nothing to back up to"
    return 0
  fi

  local clone_dir result sha mode
  clone_dir=$(identity_prepare_clone "$fork_url")
  if ! result=$(identity_commit_and_push "$clone_dir" "$IDENTITY_STATE_DIR" "$recipient"); then
    return $?
  fi
  sha="${result%% *}"
  mode="${result##* }"

  if [ "$sha" = "-" ]; then
    echo "backup-identity: no changes after stage-diff (hash $current_hash)"
    identity_write_state "$IDENTITY_BACKUP_STATE_FILE" "$current_hash" "$mode" "" ""
    return 0
  fi

  identity_write_state "$IDENTITY_BACKUP_STATE_FILE" "$current_hash" "$mode" "$sha" \
    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf 'backup-identity: %s pushed (%s)\n' "${sha:0:8}" "$mode"
}

_bi_configure_key() {
  local arg="$1"
  local key

  if [ -f "$arg" ]; then
    key=$(tr -d '\r\n' < "$arg")
  else
    key="$arg"
  fi

  if ! [[ "$key" =~ ^(ssh-ed25519|ssh-rsa)\  ]]; then
    echo "backup-identity: invalid key '$arg' — must be an ssh-ed25519 or ssh-rsa public key" >&2
    return 1
  fi

  yq -i ".backup.identity.recipient = \"$key\"" "$AGENT_YML" || {
    echo "backup-identity: failed to update $AGENT_YML" >&2
    return 2
  }
  echo "backup-identity: recipient updated"

  # 046 (U2, D29): with an associated repository, the fingerprint the operator
  # must recognise, and the consequence for the encrypted units.
  if _repo_dest_url > /dev/null 2>&1; then
    local _fp _comment
    _fp=$(python3 "$BACKUP_STORE_PY" fingerprint "$key" 2> /dev/null) || _fp="unknown"
    _comment=$(printf '%s\n' "$key" | awk '{ $1 = ""; $2 = ""; sub(/^  */, ""); print }')
    echo "backup-identity: key fingerprint $_fp (${_comment:-no comment})"
    echo "backup-identity: encrypted units re-encrypt for this key on their next run (full upload)"
  fi

  _bi_run
}
_bi_disable() {
  yq -i '.features.identity_backup.enabled = false' "$AGENT_YML" || return 2
  echo "backup-identity: identity_backup disabled in agent.yml"
  cmd_reload >/dev/null 2>&1 || true
}

_bi_gc_then_run() {
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    local _c="${IDENTITY_BACKUP_CACHE_DIR:-/home/agent/.cache/identity-backup}/identity-repo"
    _repo_gc_locked identity "$_c"
    _bi_run
    return $?
  fi
  local fork_url
  fork_url=$(_yq '.scaffold.fork.url')
  [ -z "$fork_url" ] && { echo "backup-identity: no fork url"; return 0; }
  local clone_dir
  clone_dir=$(identity_prepare_clone "$fork_url")
  (cd "$clone_dir" && git gc --prune=now --aggressive >/dev/null 2>&1) || true
  _bi_run
}

# Vault backup primitive — analogous to cmd_backup_identity. Snapshots
# the markdown subset of the configured vault to a 'backup/vault' orphan
# branch on the agent's fork. Idempotent.
cmd_backup_vault() {
  local mode="run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) mode="dry-run"; shift ;;
      --gc)      mode="gc"; shift ;;
      -h|--help)
        cat <<EOF
Usage: heartbeatctl backup-vault [flags]

Flags:
  --dry-run   Stage + hash without push.
  --gc        Run 'git gc' on the local clone before push.
  (no flags)  Default: run the vault backup primitive.
EOF
        return 0 ;;
      *) echo "backup-vault: unknown flag: $1" >&2; return 1 ;;
    esac
  done

  case "$mode" in
    run)     _bv_run ;;
    dry-run) _bv_run --dry-run ;;
    gc)      _bv_gc_then_run ;;
  esac
}

# Resolve the vault directory the agent should back up. Tests override
# via $VAULT_BACKUP_DIR; production reads it from agent.yml via
# vault_resolve_root.
_bv_dir() {
  if [ -n "${VAULT_BACKUP_DIR:-}" ]; then
    printf '%s\n' "$VAULT_BACKUP_DIR"
    return
  fi
  command -v vault_resolve_root >/dev/null 2>&1 || return 0
  vault_resolve_root "$AGENT_YML"
}

_bv_run() {
  local dry_run=0
  [ "${1:-}" = "--dry-run" ] && dry_run=1

  local vault_dir
  vault_dir=$(_bv_dir)
  if [ -z "$vault_dir" ]; then
    echo "backup-vault: vault not enabled in agent.yml — nothing to back up"
    return 0
  fi
  if [ ! -d "$vault_dir" ]; then
    echo "backup-vault: vault dir $vault_dir does not exist yet — skipping"
    return 0
  fi

  # 046: with an associated repository, the repo path (U1, U4).
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    _bv_run_repo "$_dest_url" "$dry_run" "$vault_dir"
    return $?
  fi
  # 046 (U4, I13): a sensitive agent's vault never travels in plaintext, and a fork
  # cannot carry it encrypted.
  if [ "$(_yq '.backup.sensitive')" = "true" ] && [ -n "$(_yq '.scaffold.fork.url')" ]; then
    echo "backup-vault: this agent is marked as sensitive and has no agent repository - not pushing the vault in plaintext"
    return 0
  fi

  local fork_url
  fork_url=$(_yq '.scaffold.fork.url')

  local current_hash last_hash
  current_hash=$(vault_hash "$vault_dir")
  last_hash=$(vault_last_hash "$VAULT_BACKUP_STATE_FILE")

  if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
    echo "backup-vault: no changes since last backup (hash $last_hash)"
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "backup-vault: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    return 0
  fi

  if [ -z "$fork_url" ]; then
    echo "backup-vault: agent.yml has no scaffold.fork.url — nothing to back up to"
    return 0
  fi

  local clone_dir sha
  clone_dir=$(vault_prepare_clone "$fork_url")
  if ! sha=$(vault_commit_and_push "$clone_dir" "$vault_dir"); then
    return $?
  fi

  if [ "$sha" = "-" ]; then
    echo "backup-vault: no changes after stage-diff (hash $current_hash)"
    vault_write_state "$VAULT_BACKUP_STATE_FILE" "$current_hash" "" ""
    return 0
  fi

  vault_write_state "$VAULT_BACKUP_STATE_FILE" "$current_hash" "$sha" \
    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf 'backup-vault: %s pushed\n' "${sha:0:8}"
}

_bv_gc_then_run() {
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    local _c="${VAULT_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}/vault-repo"
    _repo_gc_locked vault "$_c"
    _bv_run
    return $?
  fi
  local fork_url
  fork_url=$(_yq '.scaffold.fork.url')
  [ -z "$fork_url" ] && { echo "backup-vault: no fork url"; return 0; }
  local clone_dir
  clone_dir=$(vault_prepare_clone "$fork_url")
  (cd "$clone_dir" && git gc --prune=now --aggressive >/dev/null 2>&1) || true
  _bv_run
}

# Config backup primitive — snapshots agent.yml to backup/config.
cmd_backup_config() {
  local mode="run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) mode="dry-run"; shift ;;
      --gc)      mode="gc"; shift ;;
      -h|--help)
        cat <<EOF
Usage: heartbeatctl backup-config [flags]

Flags:
  --dry-run   Stage + hash without push.
  --gc        Run 'git gc' on the local clone before push.
  (no flags)  Default: run the config backup primitive.
EOF
        return 0 ;;
      *) echo "backup-config: unknown flag: $1" >&2; return 1 ;;
    esac
  done

  case "$mode" in
    run)     _bc_run ;;
    dry-run) _bc_run --dry-run ;;
    gc)      _bc_gc_then_run ;;
  esac
}

_bc_run() {
  local dry_run=0
  [ "${1:-}" = "--dry-run" ] && dry_run=1

  if [ ! -f "$AGENT_YML" ]; then
    echo "backup-config: $AGENT_YML missing — nothing to back up"
    return 0
  fi

  # 046: with an associated repository, the repo path (U1, U3). Then, whatever the
  # result, the work clone is created or repaired (A4), without changing the
  # unit's exit code or output.
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    local _bc_rc=0
    _bc_run_repo "$_dest_url" "$dry_run" || _bc_rc=$?
    if [ "$dry_run" != "1" ] && command -v agent_repo_ensure > /dev/null 2>&1; then
      agent_repo_ensure "$AGENT_YML" > /dev/null 2>&1 || true
    fi
    return "$_bc_rc"
  fi

  local fork_url
  fork_url=$(_yq '.scaffold.fork.url')

  local current_hash last_hash
  current_hash=$(config_hash "$AGENT_YML")
  last_hash=$(config_last_hash "$CONFIG_BACKUP_STATE_FILE")

  if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
    echo "backup-config: no changes since last backup (hash $last_hash)"
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "backup-config: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    return 0
  fi

  if [ -z "$fork_url" ]; then
    echo "backup-config: agent.yml has no scaffold.fork.url — nothing to back up to"
    return 0
  fi

  local clone_dir sha
  clone_dir=$(config_prepare_clone "$fork_url")
  if ! sha=$(config_commit_and_push "$clone_dir" "$AGENT_YML"); then
    return $?
  fi

  if [ "$sha" = "-" ]; then
    echo "backup-config: no changes after stage-diff (hash $current_hash)"
    config_write_state "$CONFIG_BACKUP_STATE_FILE" "$current_hash" "" ""
    return 0
  fi

  config_write_state "$CONFIG_BACKUP_STATE_FILE" "$current_hash" "$sha" \
    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf 'backup-config: %s pushed\n' "${sha:0:8}"
}

_bc_gc_then_run() {
  local _dest_url
  if _dest_url=$(_repo_dest_url); then
    local _c="${CONFIG_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}/config-repo"
    _repo_gc_locked config "$_c"
    _bc_run
    return $?
  fi
  local fork_url
  fork_url=$(_yq '.scaffold.fork.url')
  [ -z "$fork_url" ] && { echo "backup-config: no fork url"; return 0; }
  local clone_dir
  clone_dir=$(config_prepare_clone "$fork_url")
  (cd "$clone_dir" && git gc --prune=now --aggressive >/dev/null 2>&1) || true
  _bc_run
}

# ── 046: the repo path of the backup units ─────────────────────────────────
#
# Contract: specs/046-agent-backup-repo/contracts/backup-units.md (U1). These
# helpers never stage, commit or push: each unit's own library does that. They
# take the unit lock, check the credential and the destination, print the U1
# message and record the attempt (backup_dest_record).

# _repo_dest_url -> stdout: the associated repository URL; rc 1 when the
# destination is a fork, nothing, or backup_dest.sh did not load.
_repo_dest_url() {
  command -v backup_dest_resolve > /dev/null 2>&1 || return 1
  local d
  d=$(backup_dest_resolve "$AGENT_YML")
  [ "${d%%$'\t'*}" = "repo" ] || return 1
  printf '%s\n' "${d#*$'\t'}"
}

_REPO_RC=0

# _repo_end: releases the unit lock.
_repo_end() {
  backup_dest_unlock
}

# _repo_gc_locked UNIT CACHE_DIR: git gc on a unit cache only while holding the unit
# lock, since a concurrent run (the supervisor's trigger) could be committing there.
# Silent when the lock is taken: the run that follows reports it.
_repo_gc_locked() {
  [ -d "$2/.git" ] || return 0
  backup_dest_lock "$1" || return 0
  if command -v timeout > /dev/null 2>&1; then
    (cd "$2" && timeout -k 10 600 env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
       git gc --prune=now --aggressive > /dev/null 2>&1 9>&-) || true
  else
    (cd "$2" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
       git gc --prune=now --aggressive > /dev/null 2>&1 9>&-) || true
  fi
  backup_dest_unlock
}

# 1 while a --dry-run runs: _repo_fail then records nothing (the supervisor and
# backup-status read that record).
_REPO_DRY=0

# _repo_fail UNIT RESULT [ATTEMPTED_HASH] [REASON]: the U1 message, the record of
# the attempt, the lock released, and _REPO_RC set to the U1 exit code.
_repo_fail() {
  local unit="$1" result="$2" attempted="${3:-}" reason="${4:-}"
  case "$result" in
    no-credential)  echo "backup-$unit: no GITHUB_PAT in the environment - cannot push to the agent repository"; _REPO_RC=0 ;;
    nothing-to-back-up) echo "backup-$unit: nothing to back up yet"; _REPO_RC=0 ;;
    no-recipient)   echo "backup-$unit: no encryption key (backup.identity.recipient) - nothing pushed"; _REPO_RC=0 ;;
    not-private)    echo "backup-$unit: the repository is public - refusing to push"; _REPO_RC=0 ;;
    unverified)     echo "backup-$unit: could not verify that the repository is private - refusing to push"; _REPO_RC=0 ;;
    foreign-branch) echo "backup-$unit: branch backup/$unit exists and is not a launcher backup - refusing to write"; _REPO_RC=0 ;;
    other-agent)    echo "backup-$unit: branch backup/$unit belongs to another agent - refusing to write"; _REPO_RC=0 ;;
    unreachable)    echo "backup-$unit: repository unreachable (credential, network or missing repository)"; _REPO_RC=2 ;;
    push-failed)    echo "backup-$unit: push failed" >&2; _REPO_RC=2 ;;
    no-main)        echo "backup-$unit: the repository has no main branch - nothing pushed"; _REPO_RC=0 ;;
    main-busy)      echo "backup-$unit: main kept moving - nothing pushed, retrying next cycle"; _REPO_RC=2 ;;
    main-protected) echo "backup-$unit: main is protected and the pull request could not be merged - nothing pushed"; _REPO_RC=2 ;;
    foreign-dir)    echo "backup-$unit: .agent-backup/$unit exists in main and is not a launcher backup - refusing to write"; _REPO_RC=0 ;;
    other-agent-dir) echo "backup-$unit: .agent-backup/$unit in main belongs to another agent - refusing to write"; result="other-agent"; _REPO_RC=0 ;;
    *)              echo "backup-$unit: could not build the backup (${reason:-unknown})" >&2; result="error"; _REPO_RC=2 ;;
  esac
  [ "$_REPO_DRY" = "1" ] || backup_dest_record "$unit" "$result" "$attempted"
  _repo_end
}

# _repo_begin UNIT [DRY_RUN]: steps 2 and 3 of U1 (the lock and the credential).
# rc 0 to continue; rc 1 to stop, with _REPO_RC set.
_repo_begin() {
  local unit="$1"
  _REPO_RC=0
  # 048: with a repository the unit caches are local; the tree goes into main.
  export BACKUP_REPO_TARGET=main
  _REPO_DRY="${2:-0}"
  if ! backup_dest_lock "$unit"; then
    echo "backup-$unit: another run holds the lock - skipping"
    _REPO_RC=0
    return 1
  fi
  if [ -z "${GITHUB_PAT:-}" ]; then
    _repo_fail "$unit" no-credential
    return 1
  fi
  return 0
}

# _repo_verify UNIT URL HASH HEADS_FILE: step 7 of U1 (privacy and the heads of
# the repository). rc 0 with _REPO_REMOTE_HEAD set (empty when the unit's branch
# does not exist); rc 1 to stop, with the attempt recorded.
_REPO_REMOTE_HEAD=""
_repo_verify() {
  local unit="$1" url="$2" hash="$3" heads="$4" verdict
  _REPO_REMOTE_HEAD=""
  verdict=$(backup_dest_verify "$url" "$heads")
  case "$verdict" in
    private|unverified-allowed)
      _REPO_REMOTE_HEAD=$(backup_dest_branch_head "$heads" "backup/$unit")
      return 0 ;;
    public)     _repo_fail "$unit" not-private "$hash" ;;
    unverified) _repo_fail "$unit" unverified "$hash" ;;
    *)          _repo_fail "$unit" unreachable "$hash" ;;
  esac
  return 1
}

# _repo_state_field FILE FIELD -> a field of a unit state file, empty if unreadable.
_repo_state_field() {
  [ -s "$1" ] || return 0
  jq -r --arg k "$2" '.[$k] // "" | tostring' "$1" 2> /dev/null || true
}

# _repo_commit_iso DIR REV -> the commit date of REV in ISO 8601 UTC with Z.
_repo_commit_iso() {
  local e
  e=$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$1" log -1 --format=%ct "$2" 2> /dev/null) || e=""
  [ -n "$e" ] || e=$(date +%s)
  date -u -d "@$e" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null || date -u -r "$e" +%Y-%m-%dT%H:%M:%SZ
}

_repo_agent_name() {
  local n
  n=$(_yq '.agent.name' 2> /dev/null) || n=""
  printf '%s\n' "${n:-agent}"
}

_repo_now_iso() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# _repo_owner_ok UNIT DIR HASH: step 10 of U1. rc 1 (attempt recorded) when the
# remote branch is not this agent's.
_repo_owner_ok() {
  local unit="$1" dir="$2" hash="$3"
  case "$(backup_dest_check_owner "$dir" "backup/$unit" "$(_repo_agent_name)" "$unit")" in
    foreign)     _repo_fail "$unit" foreign-branch "$hash"; return 1 ;;
    other-agent) _repo_fail "$unit" other-agent "$hash"; return 1 ;;
  esac
  return 0
}

# ── 048: the main destination (contracts/main-backup.md) ────────────────────
#
# With a repository every unit stages and commits in its own cache, as in 046, but
# that cache is local only (BACKUP_REPO_TARGET=main): its commit is not pushed to a
# backup/<unit> branch. Its tree is published into .agent-backup/<unit>/ of main by
# backup_main.sh, over the current tip, never forced.

_REPO_MAIN_DIR=""
_REPO_MAIN_TIP=""
_REPO_MAIN_TREE=""
_REPO_MAIN_UTREE=""
_REPO_MAIN_COMMIT=""
_REPO_MAIN_VERIFIED=0
_REPO_MAIN_HEADS=""
_REPO_MAIN_STATE=""
_REPO_MAIN_FETCHED=0

# _repo_main_begin UNIT URL UNIT_CACHE HASH HEADS_FILE: M2 steps 1 to 3. rc 1 to
# stop, with the attempt recorded.
_repo_main_begin() {
  local unit="$1" url="$2" ucache="$3" hash="$4" heads="$5"
  _REPO_MAIN_STATE="${6:-}"
  _REPO_MAIN_TREE=""; _REPO_MAIN_TIP=""; _REPO_MAIN_COMMIT=""; _REPO_MAIN_UTREE=""
  _REPO_MAIN_VERIFIED=0; _REPO_MAIN_HEADS="$heads"; _REPO_MAIN_FETCHED=0
  if [ -z "$(backup_dest_branch_head "$heads" main)" ]; then
    _repo_fail "$unit" no-main "$hash"
    return 1
  fi
  if ! _REPO_MAIN_DIR=$(backup_main_prepare "$(dirname "$ucache")" "$unit" "$url" "$ucache"); then
    _repo_fail "$unit" unreachable "$hash"
    return 1
  fi
  # When main has not moved since this unit's last run, what it holds is what the
  # state recorded: no fetch at all (the 046 cost of a cycle without changes).
  local head state_tip state_tree
  head=$(backup_dest_branch_head "$heads" main)
  state_tip=$(_repo_state_field "$_REPO_MAIN_STATE" main_tip)
  state_tree=$(_repo_state_field "$_REPO_MAIN_STATE" last_tree)
  if [ -n "$state_tip" ] && [ "$head" = "$state_tip" ] && [ -n "$state_tree" ]; then
    _REPO_MAIN_TIP="$head"
    _REPO_MAIN_TREE="$state_tree"
    _REPO_MAIN_FETCHED=0
    return 0
  fi
  if ! _REPO_MAIN_TIP=$(backup_main_fetch "$_REPO_MAIN_DIR"); then
    _repo_fail "$unit" unreachable "$hash"
    return 1
  fi
  _REPO_MAIN_FETCHED=1
  _REPO_MAIN_TREE=$(backup_main_tree "$_REPO_MAIN_DIR" "$unit")
  case "$(backup_main_owner "$_REPO_MAIN_DIR" "$unit" "$(_repo_agent_name)")" in
    foreign)     _repo_fail "$unit" foreign-dir "$hash"; return 1 ;;
    other-agent) _repo_fail "$unit" other-agent-dir "$hash"; return 1 ;;
    unreachable) _repo_fail "$unit" unreachable "$hash"; return 1 ;;
  esac
  return 0
}

# _repo_main_unchanged UNIT STATE HASH LAST_HASH: M2 step 4. rc 0 (and the run is
# over: printed, recorded, legacy branch handled, lock released) when nothing changed.
_repo_main_unchanged() {
  local unit="$1" state="$2" hash="$3" last_hash="$4" last_tree
  last_tree=$(_repo_state_field "$state" last_tree)
  # config also owns .agent-backup/README.md: a README main lacks, or one of an older
  # launcher, is a change (it is checked only once main was fetched).
  if [ "$unit" = "config" ] && [ "$_REPO_MAIN_FETCHED" = "1" ] && command -v config_main_readme > /dev/null 2>&1; then
    local want have
    want=$(config_main_readme "$(_repo_agent_name)" | GIT_CONFIG_GLOBAL=/dev/null git hash-object --stdin 2> /dev/null) || want=""
    have=$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$_REPO_MAIN_DIR" \
             rev-parse --verify -q "refs/remotes/origin/main:.agent-backup/README.md" 2> /dev/null) || have=""
    [ "$want" = "$have" ] || return 1
  fi
  if [ -n "$last_hash" ] && [ "$hash" = "$last_hash" ] \
     && [ -n "$_REPO_MAIN_TREE" ] && [ "$_REPO_MAIN_TREE" = "$last_tree" ]; then
    echo "backup-$unit: no changes since last backup (hash $last_hash)"
    backup_dest_record "$unit" no-change "$hash"
    _REPO_MAIN_UTREE="$last_tree"
    _REPO_MAIN_VERIFIED=1
    _repo_main_done "$unit" "$state"
    _repo_end
    return 0
  fi
  return 1
}

# _repo_main_publish UNIT UNIT_CACHE HASH STATE [README]: M2 steps 5, 7, 8 and 9.
# Sets _REPO_MAIN_COMMIT ("-" when main already holds this tree). rc 1 to stop.
_repo_main_publish() {
  local unit="$1" ucache="$2" hash="$3" state="$4" readme="${5:-}" last_tree utree commit rc=0
  utree=$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$ucache" rev-parse 'HEAD^{tree}' 2> /dev/null) || utree=""
  if [ -z "$utree" ]; then
    _repo_fail "$unit" error "$hash" "commit"
    return 1
  fi
  _REPO_MAIN_UTREE="$utree"
  if ! backup_main_link "$_REPO_MAIN_DIR" "$ucache"; then
    _repo_fail "$unit" error "$hash" "commit"
    return 1
  fi
  last_tree=$(_repo_state_field "$state" last_tree)
  if [ -n "$_REPO_MAIN_TREE" ] && [ -n "$last_tree" ] && [ "$_REPO_MAIN_TREE" != "$last_tree" ] \
     && [ "$_REPO_MAIN_TREE" != "$utree" ]; then
    echo "backup-$unit: .agent-backup/$unit in main was changed outside the launcher - restoring it" >&2
  fi
  local readme_ok=1 want="" have=""
  if [ -n "$readme" ]; then
    want=$(GIT_CONFIG_GLOBAL=/dev/null git hash-object "$readme" 2> /dev/null) || want=""
    have=$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$_REPO_MAIN_DIR" \
             rev-parse --verify -q "refs/remotes/origin/main:.agent-backup/README.md" 2> /dev/null) || have=""
    [ "$want" = "$have" ] || readme_ok=0
  fi
  if [ "$_REPO_MAIN_FETCHED" = "0" ] && { [ "$_REPO_MAIN_TREE" != "$utree" ] || [ -n "$readme" ]; }; then
    if ! _REPO_MAIN_TIP=$(backup_main_fetch "$_REPO_MAIN_DIR"); then
      _repo_fail "$unit" unreachable "$hash"
      return 1
    fi
    _REPO_MAIN_FETCHED=1
    _REPO_MAIN_TREE=$(backup_main_tree "$_REPO_MAIN_DIR" "$unit")
    if [ -n "$readme" ]; then
      have=$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$_REPO_MAIN_DIR" \
               rev-parse --verify -q "refs/remotes/origin/main:.agent-backup/README.md" 2> /dev/null) || have=""
      if [ "$want" = "$have" ]; then readme_ok=1; else readme_ok=0; fi
    fi
  fi
  if [ "$_REPO_MAIN_TREE" = "$utree" ] && [ "$readme_ok" = "1" ]; then
    _REPO_MAIN_COMMIT="-"
    _REPO_MAIN_VERIFIED=1
    return 0
  fi
  commit=$(backup_main_publish "$_REPO_MAIN_DIR" "$unit" "$(_repo_agent_name)" "$utree" "$readme") || rc=$?
  case "$rc" in
    0) ;;
    3) _repo_fail "$unit" main-busy "$hash"; return 1 ;;
    4)
      # Contract P: main refuses a direct push; open a pull request and merge it.
      local pcommit
      pcommit=$(backup_main_build_commit "$_REPO_MAIN_DIR" "$unit" "$(_repo_agent_name)" "$utree" "$readme") || pcommit=""
      if [ -z "$pcommit" ] || ! command -v backup_pr_merge > /dev/null 2>&1 \
         || ! backup_pr_merge "$_REPO_MAIN_DIR" "$unit" "$(_repo_agent_name)" "$pcommit" \
                "$(_repo_dest_url)"; then
        _repo_fail "$unit" main-protected "$hash"
        return 1
      fi
      commit="$pcommit" ;;
    *) _repo_fail "$unit" push-failed "$hash"; return 1 ;;
  esac
  _REPO_MAIN_COMMIT="$commit"
  if backup_main_verify "$_REPO_MAIN_DIR" "$unit" "$utree"; then
    _REPO_MAIN_VERIFIED=1
  else
    _REPO_MAIN_VERIFIED=0
  fi
  return 0
}

# _repo_main_done UNIT STATE: the main fields of the state (data-model section 3) and
# the legacy branch (contract L, US4). Never changes the outcome of the run.
_repo_main_done() {
  local unit="$1" state="$2" dir tmp base='{}'
  dir=$(dirname "$state")
  mkdir -p "$dir" 2> /dev/null || return 0
  if [ -s "$state" ] && jq -e 'type == "object"' "$state" > /dev/null 2>&1; then
    base=$(cat "$state")
  fi
  tmp=$(mktemp "$dir/.$unit-main.XXXXXX" 2> /dev/null) || return 0
  local tip="$_REPO_MAIN_TIP"
  if [ -n "$_REPO_MAIN_COMMIT" ] && [ "$_REPO_MAIN_COMMIT" != "-" ]; then tip="$_REPO_MAIN_COMMIT"; fi
  [ "$_REPO_MAIN_VERIFIED" = "1" ] || tip=""
  if jq --arg tree "$_REPO_MAIN_UTREE" --arg tip "$tip" \
        '. + {location:"main", last_tree:$tree, main_tip:$tip}' <<< "$base" > "$tmp" 2> /dev/null; then
    mv -f "$tmp" "$state"
  else
    rm -f "$tmp"
  fi
  if command -v _repo_main_legacy > /dev/null 2>&1; then
    _repo_main_legacy "$unit" "$state" || true
  fi
  [ "$unit" = "config" ] && _repo_main_size_refresh
  return 0
}

# _repo_main_size_refresh: the repository size GitHub reports (GET /repos/{o}/{r},
# field size, in KB), at most once a day, into scripts/heartbeat/backup-repo-size.json
# (contract D4; not the destination record, which backup_dest_verify rewrites).
# backup-status reads it and never touches the network itself.
_repo_main_size_refresh() {
  command -v _backup_pr_call > /dev/null 2>&1 || return 0
  [ -n "${GITHUB_PAT:-}" ] || return 0
  local f="$HEARTBEAT_DIR/backup-repo-size.json" now last url cfg resp size tmp base='{}'
  now=$(date +%s)
  last=$(jq -r '.repo_size_checked_epoch // 0' "$f" 2> /dev/null) || last=0
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge 86400 ] || return 0
  url=$(_repo_dest_url) || return 0
  cfg=$(mktemp "${TMPDIR:-/tmp}/backup-size-cfg.XXXXXX") || return 0
  chmod 600 "$cfg"
  printf 'header = "Authorization: Bearer %s"\n' "$GITHUB_PAT" > "$cfg"
  resp=$(_backup_pr_call "$cfg" GET "$(_backup_pr_api_base)/repos/$(_backup_pr_repo_path "$url")")
  rm -f "$cfg"
  [ "${resp%% *}" = "200" ] || return 0
  size=$(jq -r '.size // empty' <<< "${resp#* }" 2> /dev/null) || size=""
  case "$size" in ''|*[!0-9]*) return 0 ;; esac
  [ -s "$f" ] && jq -e 'type == "object"' "$f" > /dev/null 2>&1 && base=$(cat "$f")
  tmp=$(mktemp "$(dirname "$f")/.backup-repo-size.XXXXXX") || return 0
  if jq --argjson s "$size" --argjson e "$now" '. + {repo_size_kb:$s, repo_size_checked_epoch:$e}' <<< "$base" > "$tmp"; then
    mv -f "$tmp" "$f"
  else
    rm -f "$tmp"
  fi
  return 0
}

# _repo_main_legacy UNIT STATE: contract L. Deletes the unit's legacy backup/<unit>
# branch only when main verifiably holds this unit's tree and the branch carries this
# agent's mark. Records legacy_branch; never changes the result of the run.
_repo_main_legacy() {
  local unit="$1" state="$2" head verdict value="" line=""
  head=$(backup_dest_branch_head "$_REPO_MAIN_HEADS" "backup/$unit")
  if [ -z "$head" ]; then
    value="none"
  elif [ "$_REPO_MAIN_VERIFIED" != "1" ]; then
    value="kept: not-verified"
  else
    verdict=$(backup_main_legacy_owner "$_REPO_MAIN_DIR" "$unit" "$(_repo_agent_name)")
    case "$verdict" in
      ok)
        if backup_main_delete_branch "$_REPO_MAIN_DIR" "$unit"; then
          value="deleted $(_repo_now_iso)"
          line="backup-$unit: legacy branch backup/$unit deleted (its backup is in main)"
        else
          value="kept: delete-failed"
        fi ;;
      no-mark)     value="kept: no-mark";     echo "backup-$unit: legacy branch backup/$unit has no launcher mark - left alone" >&2 ;;
      unreachable) value="kept: not-verified" ;;
      other-agent) value="kept: other-agent"; echo "backup-$unit: legacy branch backup/$unit belongs to another agent - left alone" >&2 ;;
      *)           value="kept: not-verified" ;;
    esac
  fi
  [ -n "$line" ] && echo "$line"
  local dir tmp base='{}'
  dir=$(dirname "$state")
  if [ -s "$state" ] && jq -e 'type == "object"' "$state" > /dev/null 2>&1; then
    base=$(cat "$state")
  fi
  # A branch deleted in an earlier cycle stays recorded as deleted.
  case "$value" in none) case "$(jq -r '.legacy_branch // ""' <<< "$base" 2> /dev/null)" in deleted*) return 0 ;; esac ;; esac
  tmp=$(mktemp "$dir/.$unit-legacy.XXXXXX" 2> /dev/null) || return 0
  if jq --arg v "$value" '. + {legacy_branch:$v}' <<< "$base" > "$tmp" 2> /dev/null; then
    mv -f "$tmp" "$state"
  else
    rm -f "$tmp"
  fi
  return 0
}

# identity, repo path: the thirteen steps of U1 (U2).
_bi_run_repo() {
  local url="$1" dry_run="${2:-0}"
  _repo_begin identity "$dry_run" || return "$_REPO_RC"

  local recipient secrets current_hash last_hash last_commit base
  recipient=$(_yq '.backup.identity.recipient')
  [ "$recipient" = "null" ] && recipient=""
  secrets=$(identity_secrets_file repo "$WORKSPACE" "$IDENTITY_STATE_DIR")
  current_hash=$(identity_hash "$IDENTITY_STATE_DIR" "$recipient" "$secrets" 2> /dev/null) || current_hash=""
  if [ -z "$current_hash" ]; then
    _repo_fail identity error "" "hash"
    return "$_REPO_RC"
  fi
  last_hash=$(_repo_state_field "$IDENTITY_BACKUP_STATE_FILE" hash)

  if [ "$dry_run" = "1" ]; then
    if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
      echo "backup-identity: no changes since last backup (hash $last_hash)"
    else
      echo "backup-identity: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    fi
    _repo_end
    return 0
  fi

  base="${IDENTITY_BACKUP_CACHE_DIR:-/home/agent/.cache/identity-backup}"
  mkdir -p "$base"
  _repo_verify identity "$url" "$current_hash" "$base/identity-repo.heads" || return "$_REPO_RC"

  last_commit=$(_repo_state_field "$IDENTITY_BACKUP_STATE_FILE" last_commit)
  # 048: the destination is .agent-backup/identity/ of main.
  _repo_main_begin identity "$url" "$base/identity-repo" "$current_hash" "$base/identity-repo.heads" "$IDENTITY_BACKUP_STATE_FILE" || return "$_REPO_RC"
  if _repo_main_unchanged identity "$IDENTITY_BACKUP_STATE_FILE" "$current_hash" "$last_hash"; then return 0; fi

  local dir
  if ! dir=$(identity_repo_prepare "$url" ""); then
    _repo_fail identity unreachable "$current_hash"
    return "$_REPO_RC"
  fi

  local result rc=0 sha mode push
  result=$(identity_repo_commit_and_push "$dir" "$IDENTITY_STATE_DIR" "$recipient" "$secrets" \
             "$(_repo_agent_name)") || rc=$?
  case "$rc" in
    0) ;;
    2) _repo_fail identity push-failed "$current_hash"; return "$_REPO_RC" ;;
    *) _repo_fail identity error "$current_hash" "staging"; return "$_REPO_RC" ;;
  esac
  sha="${result%% *}"
  mode="${result##* }"
  _repo_main_publish identity "$dir" "$current_hash" "$IDENTITY_BACKUP_STATE_FILE" || return "$_REPO_RC"
  sha="$_REPO_MAIN_COMMIT"
  if [ "$sha" = "-" ]; then
    push=$(_repo_state_field "$IDENTITY_BACKUP_STATE_FILE" last_push)
    [ -n "$push" ] || push=$(_repo_now_iso)
    identity_repo_write_state "$IDENTITY_BACKUP_STATE_FILE" "$current_hash" "$mode" "${last_commit:-$_REPO_MAIN_TIP}" "$push"
    echo "backup-identity: no changes after stage-diff (hash $current_hash)"
    backup_dest_record identity no-change "$current_hash"
    _repo_main_done identity "$IDENTITY_BACKUP_STATE_FILE"
    _repo_end
    return 0
  fi
  identity_repo_write_state "$IDENTITY_BACKUP_STATE_FILE" "$current_hash" "$mode" "$sha" "$(_repo_now_iso)"
  backup_dest_record identity ok "$current_hash"
  _repo_main_done identity "$IDENTITY_BACKUP_STATE_FILE"
  printf 'backup-identity: %s pushed (%s)\n' "${sha:0:8}" "$mode"
  _repo_end
  return 0
}

# vault, repo path (U1, U4): the markdown in plaintext.
_bv_run_repo() {
  local url="$1" dry_run="${2:-0}" vault_dir="$3"
  _repo_begin vault "$dry_run" || return "$_REPO_RC"

  local n=0 _p
  while IFS= read -r -d '' _p; do n=$((n + 1)); done < <(vault_list_markdown "$vault_dir")
  if [ "$n" -eq 0 ]; then
    _repo_fail vault nothing-to-back-up
    return "$_REPO_RC"
  fi

  local current_hash last_hash last_commit base sensitive recipient
  base="${VAULT_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  mkdir -p "$base"
  sensitive=$(_repo_sensitive)
  recipient=$(_yq '.backup.identity.recipient')
  if [ "$sensitive" = "true" ]; then
    # U4: the same files, all of them in store/.
    : > "$base/vault-repo.map"
    local _rel
    while IFS= read -r -d '' _p; do
      _rel="${_p#"$vault_dir"/}"
      printf '%s\0%s\0' "$_rel" "$_p" >> "$base/vault-repo.map"
    done < <(vault_list_markdown "$vault_dir")
    if [ -z "$recipient" ]; then
      _repo_fail vault no-recipient
      return "$_REPO_RC"
    fi
    current_hash=$(_repo_store_digest "$base/vault-repo.map" "$base/vault-repo.snap" "$sensitive" "$recipient") || current_hash=""
  else
    current_hash=$(vault_hash "$vault_dir" 2> /dev/null) || current_hash=""
  fi
  if [ -z "$current_hash" ]; then
    _repo_fail vault error "" "hash"
    return "$_REPO_RC"
  fi
  last_hash=$(_repo_state_field "$VAULT_BACKUP_STATE_FILE" hash)

  if [ "$dry_run" = "1" ]; then
    if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
      echo "backup-vault: no changes since last backup (hash $last_hash)"
    else
      echo "backup-vault: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    fi
    _repo_end
    return 0
  fi

  _repo_verify vault "$url" "$current_hash" "$base/vault-repo.heads" || return "$_REPO_RC"

  last_commit=$(_repo_state_field "$VAULT_BACKUP_STATE_FILE" last_commit)
  # 048: the destination is .agent-backup/vault/ of main.
  _repo_main_begin vault "$url" "$base/vault-repo" "$current_hash" "$base/vault-repo.heads" "$VAULT_BACKUP_STATE_FILE" || return "$_REPO_RC"
  if _repo_main_unchanged vault "$VAULT_BACKUP_STATE_FILE" "$current_hash" "$last_hash"; then return 0; fi

  local dir keep=0 store_recip="__keep__"
  [ "$sensitive" = "true" ] && keep=1
  if ! dir=$(vault_repo_prepare "$url" "" "$keep"); then
    _repo_fail vault unreachable "$current_hash"
    return "$_REPO_RC"
  fi
  if [ "$sensitive" = "true" ]; then
    if ! store_recip=$(_repo_store_pack vault "$dir" "$base/vault-repo" "$base/vault-repo.map" \
                         "$VAULT_BACKUP_STATE_FILE" "$recipient"); then
      _repo_fail vault error "$current_hash" "store"
      return "$_REPO_RC"
    fi
  elif ! vault_repo_stage_markdown "$dir" "$vault_dir"; then
    _repo_fail vault error "$current_hash" "staging"
    return "$_REPO_RC"
  fi

  local sha rc=0 push
  sha=$(vault_repo_commit_and_push "$dir" "$(_repo_agent_name)") || rc=$?
  case "$rc" in
    0) ;;
    2) _repo_fail vault push-failed "$current_hash"; return "$_REPO_RC" ;;
    *) _repo_fail vault error "$current_hash" "commit"; return "$_REPO_RC" ;;
  esac
  _repo_main_publish vault "$dir" "$current_hash" "$VAULT_BACKUP_STATE_FILE" || return "$_REPO_RC"
  sha="$_REPO_MAIN_COMMIT"
  if [ "$sha" = "-" ]; then
    push=$(_repo_state_field "$VAULT_BACKUP_STATE_FILE" last_push)
    [ -n "$push" ] || push=$(_repo_now_iso)
    vault_repo_write_state "$VAULT_BACKUP_STATE_FILE" "$current_hash" "${last_commit:-$_REPO_MAIN_TIP}" "$push" "$store_recip"
    echo "backup-vault: no changes after stage-diff (hash $current_hash)"
    backup_dest_record vault no-change "$current_hash"
    _repo_main_done vault "$VAULT_BACKUP_STATE_FILE"
    _repo_end
    return 0
  fi
  vault_repo_write_state "$VAULT_BACKUP_STATE_FILE" "$current_hash" "$sha" "$(_repo_now_iso)" "$store_recip"
  backup_dest_record vault ok "$current_hash"
  _repo_main_done vault "$VAULT_BACKUP_STATE_FILE"
  printf 'backup-vault: %s pushed\n' "${sha:0:8}"
  _repo_end
  return 0
}

# config, repo path (U1, U3): for now, agent.yml and the mark.
_bc_run_repo() {
  local url="$1" dry_run="${2:-0}"
  _repo_begin config "$dry_run" || return "$_REPO_RC"

  local current_hash last_hash last_commit base sensitive recipient
  base="${CONFIG_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  mkdir -p "$base"
  sensitive=$(_repo_sensitive)
  recipient=$(_yq '.backup.identity.recipient')
  config_build_maps "$WORKSPACE" "$AGENT_YML" "$sensitive" "$(_repo_agent_name)" \
    "$base/config-repo.plain" "$base/config-repo.map" "$base/config-repo.all"
  if [ "$sensitive" = "true" ] && [ -z "$recipient" ]; then
    _repo_fail config no-recipient
    return "$_REPO_RC"
  fi
  current_hash=$(_repo_store_digest "$base/config-repo.all" "$base/config-repo.snap" "$sensitive" "$recipient") || current_hash=""
  if [ -z "$current_hash" ]; then
    _repo_fail config error "" "hash"
    return "$_REPO_RC"
  fi
  last_hash=$(_repo_state_field "$CONFIG_BACKUP_STATE_FILE" hash)

  if [ "$dry_run" = "1" ]; then
    if [ -n "$last_hash" ] && [ "$current_hash" = "$last_hash" ]; then
      echo "backup-config: no changes since last backup (hash $last_hash)"
    else
      echo "backup-config: dry-run (no push) — would change from ${last_hash:-<none>} to $current_hash"
    fi
    _repo_end
    return 0
  fi

  _repo_verify config "$url" "$current_hash" "$base/config-repo.heads" || return "$_REPO_RC"

  last_commit=$(_repo_state_field "$CONFIG_BACKUP_STATE_FILE" last_commit)
  # 048: the destination is .agent-backup/config/ of main.
  _repo_main_begin config "$url" "$base/config-repo" "$current_hash" "$base/config-repo.heads" "$CONFIG_BACKUP_STATE_FILE" || return "$_REPO_RC"
  if _repo_main_unchanged config "$CONFIG_BACKUP_STATE_FILE" "$current_hash" "$last_hash"; then return 0; fi

  local dir keep=0 store_recip="__keep__"
  [ "$sensitive" = "true" ] && keep=1
  if ! dir=$(config_repo_prepare "$url" "" "$keep"); then
    _repo_fail config unreachable "$current_hash"
    return "$_REPO_RC"
  fi
  if ! config_repo_stage_plain "$dir" "$base/config-repo.plain"; then
    _repo_fail config error "$current_hash" "staging"
    return "$_REPO_RC"
  fi
  if [ "$sensitive" = "true" ]; then
    if ! store_recip=$(_repo_store_pack config "$dir" "$base/config-repo" "$base/config-repo.map" \
                         "$CONFIG_BACKUP_STATE_FILE" "$recipient"); then
      _repo_fail config error "$current_hash" "store"
      return "$_REPO_RC"
    fi
  fi

  local sha rc=0 push
  sha=$(config_repo_commit_and_push "$dir" "$(_repo_agent_name)") || rc=$?
  case "$rc" in
    0) ;;
    2) _repo_fail config push-failed "$current_hash"; return "$_REPO_RC" ;;
    *) _repo_fail config error "$current_hash" "commit"; return "$_REPO_RC" ;;
  esac
  config_main_readme "$(_repo_agent_name)" > "$base/agent-backup-readme.md" || true
  _repo_main_publish config "$dir" "$current_hash" "$CONFIG_BACKUP_STATE_FILE" "$base/agent-backup-readme.md" || return "$_REPO_RC"
  sha="$_REPO_MAIN_COMMIT"
  if [ "$sha" = "-" ]; then
    push=$(_repo_state_field "$CONFIG_BACKUP_STATE_FILE" last_push)
    [ -n "$push" ] || push=$(_repo_now_iso)
    config_repo_write_state "$CONFIG_BACKUP_STATE_FILE" "$current_hash" "${last_commit:-$_REPO_MAIN_TIP}" "$push" "$store_recip"
    echo "backup-config: no changes after stage-diff (hash $current_hash)"
    backup_dest_record config no-change "$current_hash"
    _repo_main_done config "$CONFIG_BACKUP_STATE_FILE"
    _repo_end
    return 0
  fi
  config_repo_write_state "$CONFIG_BACKUP_STATE_FILE" "$current_hash" "$sha" "$(_repo_now_iso)" "$store_recip"
  backup_dest_record config ok "$current_hash"
  _repo_main_done config "$CONFIG_BACKUP_STATE_FILE"
  printf 'backup-config: %s pushed\n' "${sha:0:8}"
  _repo_end
  return 0
}

# _repo_sensitive -> "true" or "false" (backup.sensitive, docker mode).
_repo_sensitive() {
  if [ "$(_yq '.backup.sensitive')" = "true" ]; then echo true; else echo false; fi
}

# _repo_store_digest MAP SNAPSHOT_DIR SENSITIVE RECIPIENT -> the unit hash (data-model
# section 6): every file of the unit, plus the sensitive mark and the operator key.
# The tool's stderr goes to the unit's log: its messages carry no content (S4).
_repo_store_digest() {
  python3 "$BACKUP_STORE_PY" digest --map "$1" --snapshot-dir "$2" \
    --extra "sensitive=$3 $4"
}

# _repo_store_pack UNIT DIR CACHE_PREFIX STORE_MAP STATE_FILE RECIPIENT
# Packs STORE_MAP into DIR/store (or removes store/ when the map is empty).
# stdout: the store recipient to keep in the state; rc 1 on failure.
_repo_store_pack() {
  local unit="$1" dir="$2" prefix="$3" map="$4" state="$5" recipient="$6"
  if [ ! -s "$map" ]; then
    rm -rf "$dir/store"
    printf '\n'
    return 0
  fi
  printf '%s\n' "$recipient" > "$prefix.recipients" || return 1
  local expect out rotated
  expect=$(_repo_state_field "$state" store_recipient)
  # The block map stays next to the cache, outside the committed tree.
  local -a args=(pack --unit "$unit" --map "$map" --store "$dir/store" --recipients "$prefix.recipients"
                 --snapshot-dir "$prefix.snap" --block-map "$prefix.blockmap")
  [ -n "$expect" ] && args+=(--expect-recipient "$expect")
  if [ -n "${BACKUP_STORE_BLOCK_SIZE:-}" ]; then args+=(--block-size "$BACKUP_STORE_BLOCK_SIZE"); fi
  out=$(python3 "$BACKUP_STORE_PY" "${args[@]}") || return 1
  rotated=$(jq -r '.rotated // ""' <<< "$out" 2> /dev/null) || rotated=""
  if [ -n "$rotated" ] && [ "$rotated" != "new" ]; then
    echo "backup-$unit: store key rotated ($rotated) - full upload" >&2
  fi
  jq -r '.recipient // ""' <<< "$out"
}

# Run the shared tail of a store unit (memory, history): steps 7 to 13 of U1.
# _repo_store_unit UNIT URL HASH STATE_FILE BASE PLAIN_MAP STORE_MAP RECIPIENT
_repo_store_unit() {
  local unit="$1" url="$2" current_hash="$3" state="$4" base="$5" plain="$6" smap="$7" recipient="$8"
  local last_hash last_commit dir sha rc=0 push store_recip
  last_hash=$(_repo_state_field "$state" hash)
  _repo_verify "$unit" "$url" "$current_hash" "$base/$unit-repo.heads" || return "$_REPO_RC"
  last_commit=$(_repo_state_field "$state" last_commit)
  # 048: the destination is .agent-backup/<unit>/ of main.
  _repo_main_begin "$unit" "$url" "$base/$unit-repo" "$current_hash" "$base/$unit-repo.heads" "$state" || return "$_REPO_RC"
  if _repo_main_unchanged "$unit" "$state" "$current_hash" "$last_hash"; then return 0; fi
  if ! dir=$("${unit}_repo_prepare" "$url" ""); then
    _repo_fail "$unit" unreachable "$current_hash"
    return "$_REPO_RC"
  fi
  if [ -n "$plain" ] && ! memory_repo_stage_plain "$dir" "$plain"; then
    _repo_fail "$unit" error "$current_hash" "staging"
    return "$_REPO_RC"
  fi
  if ! store_recip=$(_repo_store_pack "$unit" "$dir" "$base/$unit-repo" "$smap" "$state" "$recipient"); then
    _repo_fail "$unit" error "$current_hash" "store"
    return "$_REPO_RC"
  fi
  sha=$("${unit}_repo_commit_and_push" "$dir" "$(_repo_agent_name)") || rc=$?
  case "$rc" in
    0) ;;
    2) _repo_fail "$unit" push-failed "$current_hash"; return "$_REPO_RC" ;;
    *) _repo_fail "$unit" error "$current_hash" "commit"; return "$_REPO_RC" ;;
  esac
  _repo_main_publish "$unit" "$dir" "$current_hash" "$state" || return "$_REPO_RC"
  sha="$_REPO_MAIN_COMMIT"
  if [ "$sha" = "-" ]; then
    push=$(_repo_state_field "$state" last_push)
    [ -n "$push" ] || push=$(_repo_now_iso)
    "${unit}_repo_write_state" "$state" "$current_hash" "${last_commit:-$_REPO_MAIN_TIP}" "$push" "$store_recip"
    echo "backup-$unit: no changes after stage-diff (hash $current_hash)"
    backup_dest_record "$unit" no-change "$current_hash"
    _repo_main_done "$unit" "$state"
    _repo_end
    return 0
  fi
  "${unit}_repo_write_state" "$state" "$current_hash" "$sha" "$(_repo_now_iso)" "$store_recip"
  backup_dest_record "$unit" ok "$current_hash"
  _repo_main_done "$unit" "$state"
  printf 'backup-%s: %s pushed\n' "$unit" "${sha:0:8}"
  _repo_end
  return 0
}

# heartbeatctl backup-memory [--dry-run] (U5). Repository only.
cmd_backup_memory() {
  local dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -h|--help) echo "Usage: heartbeatctl backup-memory [--dry-run]"; return 0 ;;
      *) echo "backup-memory: unknown flag: $1" >&2; return 1 ;;
    esac
  done
  local url
  if ! url=$(_repo_dest_url); then
    echo "backup-memory: no agent repository in agent.yml (backup.repo.url) - nothing to back up to"
    return 0
  fi
  command -v memory_build_maps > /dev/null 2>&1 || { echo "backup-memory: library missing" >&2; return 2; }
  _repo_begin memory "$dry_run" || return "$_REPO_RC"
  local base sensitive recipient h
  base=$(memory_cache_base)
  mkdir -p "$base"
  sensitive=$(_repo_sensitive)
  recipient=$(_yq '.backup.identity.recipient')
  yq -r '(.backup.extra_paths // [])[]' "$AGENT_YML" > "$base/memory-repo.extra" 2> /dev/null || : > "$base/memory-repo.extra"
  memory_build_maps "$IDENTITY_STATE_DIR" "$WORKSPACE" "$sensitive" "$base/memory-repo.extra" \
    "$base/memory-repo.plain" "$base/memory-repo.map" "$base/memory-repo.all"
  if [ ! -s "$base/memory-repo.all" ]; then
    _repo_fail memory nothing-to-back-up
    return "$_REPO_RC"
  fi
  if [ -s "$base/memory-repo.map" ] && [ -z "$recipient" ]; then
    _repo_fail memory no-recipient
    return "$_REPO_RC"
  fi
  h=$(_repo_store_digest "$base/memory-repo.all" "$base/memory-repo.snap" "$sensitive" "$recipient") || h=""
  if [ -z "$h" ]; then
    _repo_fail memory error "" "hash"
    return "$_REPO_RC"
  fi
  if [ "$dry_run" = "1" ]; then
    local last
    last=$(_repo_state_field "$MEMORY_BACKUP_STATE_FILE" hash)
    if [ -n "$last" ] && [ "$last" = "$h" ]; then
      echo "backup-memory: no changes since last backup (hash $last)"
    else
      echo "backup-memory: dry-run (no push) — would change from ${last:-<none>} to $h"
    fi
    _repo_end
    return 0
  fi
  _repo_store_unit memory "$url" "$h" "$MEMORY_BACKUP_STATE_FILE" "$base" "$base/memory-repo.plain" \
    "$base/memory-repo.map" "$recipient"
}

# heartbeatctl backup-history [--dry-run] (U6). Repository only, always encrypted.
cmd_backup_history() {
  local dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -h|--help) echo "Usage: heartbeatctl backup-history [--dry-run]"; return 0 ;;
      *) echo "backup-history: unknown flag: $1" >&2; return 1 ;;
    esac
  done
  local url
  if ! url=$(_repo_dest_url); then
    echo "backup-history: no agent repository in agent.yml (backup.repo.url) - nothing to back up to"
    return 0
  fi
  command -v history_build_map > /dev/null 2>&1 || { echo "backup-history: library missing" >&2; return 2; }
  _repo_begin history "$dry_run" || return "$_REPO_RC"
  local base sensitive recipient h
  base=$(history_cache_base)
  mkdir -p "$base"
  sensitive=$(_repo_sensitive)
  recipient=$(_yq '.backup.identity.recipient')
  history_build_map "$IDENTITY_STATE_DIR" "$base/history-repo.map"
  if [ ! -s "$base/history-repo.map" ]; then
    _repo_fail history nothing-to-back-up
    return "$_REPO_RC"
  fi
  if [ -z "$recipient" ]; then
    _repo_fail history no-recipient
    return "$_REPO_RC"
  fi
  h=$(_repo_store_digest "$base/history-repo.map" "$base/history-repo.snap" "$sensitive" "$recipient") || h=""
  if [ -z "$h" ]; then
    _repo_fail history error "" "hash"
    return "$_REPO_RC"
  fi
  if [ "$dry_run" = "1" ]; then
    local last
    last=$(_repo_state_field "$HISTORY_BACKUP_STATE_FILE" hash)
    if [ -n "$last" ] && [ "$last" = "$h" ]; then
      echo "backup-history: no changes since last backup (hash $last)"
    else
      echo "backup-history: dry-run (no push) — would change from ${last:-<none>} to $h"
    fi
    _repo_end
    return 0
  fi
  _repo_store_unit history "$url" "$h" "$HISTORY_BACKUP_STATE_FILE" "$base" "" \
    "$base/history-repo.map" "$recipient"
}

# ── 046: heartbeatctl backup-status [--json] (A6) ──────────────────────────
#
# Reads the destination rule, the unit state files, backup-dest.json, the key, the
# caches, the extra paths and the work clone. It never touches the network and never
# modifies anything; it never prints the credential, only whether it is present.

_bs_bytes() {  # PATH -> bytes on disk (du -sk * 1024), 0 when missing
  local k
  [ -e "$1" ] || { echo 0; return 0; }
  k=$(du -sk "$1" 2> /dev/null | awk '{print $1}')
  echo $(( ${k:-0} * 1024 ))
}

_bs_unit_json() {  # UNIT ENABLED MAX_HOURS STATE_FILE CACHE_DIR
  local unit="$1" enabled="$2" max="$3" state="$4" cache="$5" base='{}'
  if [ -s "$state" ] && jq -e 'type == "object"' "$state" > /dev/null 2>&1; then
    base=$(cat "$state")
  fi
  jq -c --arg unit "$unit" --argjson enabled "$enabled" --argjson max "$max" \
     --argjson cache "$(_bs_bytes "$cache")" \
     '{unit:$unit, enabled:$enabled, last_push:(.last_push // ""), last_attempt:(.last_attempt // ""),
       last_result:(.last_result // ""), max_age_hours:$max, cache_bytes:$cache}
      + (if has("location") or has("legacy_branch") then
           {location:(.location // ""), legacy_branch:(.legacy_branch // "")} else {} end)' <<< "$base"
}

_bs_flag() {  # YQ_PATH -> true unless explicitly false
  if [ "$(_yq "$1")" = "false" ]; then echo false; else echo true; fi
}

cmd_backup_status() {
  local as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      -h|--help) echo "Usage: heartbeatctl backup-status [--json]"; return 0 ;;
      *) echo "backup-status: unknown flag: $1" >&2; return 1 ;;
    esac
  done
  local dest kind url
  dest=$(backup_dest_resolve "$AGENT_YML" 2> /dev/null) || dest=$'none\t'
  kind="${dest%%$'\t'*}"
  url="${dest#*$'\t'}"
  local icache="${IDENTITY_BACKUP_CACHE_DIR:-/home/agent/.cache/identity-backup}"
  local vcache="${VAULT_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  local ccache="${CONFIG_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  local mcache="${MEMORY_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  local hcache="${HISTORY_BACKUP_CACHE_DIR:-/home/agent/.cache/agent-backup}"
  local suffix="clone"
  [ "$kind" = "repo" ] && suffix="repo"
  local vault_on=false
  [ "$(_yq '.vault.enabled')" = "true" ] && vault_on=true
  local units
  units=$(
    if [ "$kind" = "repo" ]; then
      _bs_unit_json identity "$(_bs_flag '.features.identity_backup.enabled')" 48 "$IDENTITY_BACKUP_STATE_FILE" "$icache/identity-repo"
    else
      _bs_unit_json identity "$([ "$(_yq '.features.identity_backup.enabled')" = "true" ] && echo true || echo false)" 48 "$IDENTITY_BACKUP_STATE_FILE" "$icache/clone"
    fi
    _bs_unit_json vault "$vault_on" 25 "$VAULT_BACKUP_STATE_FILE" "$vcache/vault-$suffix"
    _bs_unit_json config "$(_bs_flag '.features.config_backup.enabled')" 192 "$CONFIG_BACKUP_STATE_FILE" "$ccache/config-$suffix"
    if [ "$kind" = "repo" ]; then
      _bs_unit_json memory "$(_bs_flag '.features.memory_backup.enabled')" 49 "$MEMORY_BACKUP_STATE_FILE" "$mcache/memory-repo"
      _bs_unit_json history "$(_bs_flag '.features.history_backup.enabled')" 49 "$HISTORY_BACKUP_STATE_FILE" "$hcache/history-repo"
    fi
  )
  local verdict="" checked=""
  if [ -s "$BACKUP_DEST_STATE_FILE" ]; then
    verdict=$(jq -r '.verdict // ""' "$BACKUP_DEST_STATE_FILE" 2> /dev/null) || verdict=""
    checked=$(jq -r '.checked_at // ""' "$BACKUP_DEST_STATE_FILE" 2> /dev/null) || checked=""
  fi
  local json
  json=$(jq -s --arg kind "$kind" --arg url "$url" --arg verdict "$verdict" --arg checked "$checked" \
           '{destination:{kind:$kind, url:$url, verdict:$verdict, checked_at:$checked}, units:.}' <<< "$units")

  if [ "$kind" = "repo" ]; then
    local cred=missing sensitive=false recipient rtype="" rfp="" rcomment="" rconf=false
    [ -n "${GITHUB_PAT:-}" ] && cred=present
    [ "$(_yq '.backup.sensitive')" = "true" ] && sensitive=true
    recipient=$(_yq '.backup.identity.recipient')
    if [ -n "$recipient" ]; then
      rconf=true
      rtype="${recipient%% *}"
      rfp=$(python3 "$BACKUP_STORE_PY" fingerprint "$recipient" 2> /dev/null) || rfp=""
      rcomment=$(printf '%s\n' "$recipient" | awk '{ $1 = ""; $2 = ""; sub(/^  */, ""); print }')
    fi
    local declared=0 bytes=0 missing_json='[]' entry norm
    while IFS= read -r entry || [ -n "$entry" ]; do
      [ -n "$entry" ] || continue
      declared=$((declared + 1))
      if command -v memory_extra_path_check > /dev/null 2>&1 \
         && norm=$(memory_extra_path_check "$WORKSPACE" "$entry"); then
        bytes=$((bytes + $(_bs_bytes "$WORKSPACE/$norm")))
      else
        missing_json=$(jq -c --arg e "$entry" '. + [$e]' <<< "$missing_json")
      fi
    done < <(yq -r '(.backup.extra_paths // [])[]' "$AGENT_YML" 2> /dev/null)
    local wdir present=false unpub=0 dirty=0
    wdir=$(agent_repo_dir 2> /dev/null) || wdir="${WORKSPACE}/agent-repo"
    if [ -d "$wdir/.git" ]; then
      present=true
      unpub=$(GIT_CONFIG_GLOBAL=/dev/null git -C "$wdir" rev-list --branches --not --remotes 2> /dev/null | wc -l | tr -d ' ') || unpub=0
      dirty=$(GIT_CONFIG_GLOBAL=/dev/null git -C "$wdir" status --porcelain 2> /dev/null | wc -l | tr -d ' ') || dirty=0
    fi
    json=$(jq --arg cred "$cred" --argjson sensitive "$sensitive" --argjson rconf "$rconf" \
              --arg rtype "$rtype" --arg rfp "$rfp" --arg rcomment "$rcomment" \
              --argjson declared "$declared" --argjson missing "$missing_json" --argjson bytes "$bytes" \
              --arg wdir "$wdir" --argjson present "$present" --argjson unpub "${unpub:-0}" --argjson dirty "${dirty:-0}" \
              --argjson size "$(jq -c '.repo_size_kb // null' "$HEARTBEAT_DIR/backup-repo-size.json" 2> /dev/null || echo null)" \
       '. + {credential:$cred, sensitive:$sensitive,
             recipient:{configured:$rconf, type:$rtype, fingerprint:$rfp, comment:$rcomment},
             extra_paths:{declared:$declared, missing:$missing, bytes:$bytes},
             cache_bytes_total:([.units[].cache_bytes] | add // 0),
             repo_size_kb:$size,
             work_clone:{path:$wdir, present:$present, unpublished_commits:$unpub, dirty_files:$dirty}}' <<< "$json")
  fi

  if [ "$as_json" = "1" ]; then
    printf '%s\n' "$json"
    return 0
  fi
  _bs_print "$json"
}

# _bs_print JSON: the readable table of the same data.
_bs_print() {
  local json="$1" now
  now=$(date -u +%s)
  jq -r '"destination: \(.destination.kind) \(.destination.url) (\(.destination.verdict // "" | if . == "" then "not checked yet" else . end)\(if .destination.checked_at != "" then ", checked " + .destination.checked_at else "" end))"' <<< "$json"
  if [ "$(jq -r 'has("credential")' <<< "$json")" = "true" ]; then
    jq -r '"credential: \(.credential)",
           "sensitive: \(.sensitive)",
           (if .recipient.configured then "encryption key: \(.recipient.type) \(.recipient.fingerprint) (\(.recipient.comment))" else "encryption key: not configured" end),
           "extra paths: \(.extra_paths.declared) declared, \(.extra_paths.missing | length) missing\(if (.extra_paths.missing | length) > 0 then " (" + (.extra_paths.missing | join(", ")) + ")" else "" end)",
           "work clone: \(.work_clone.path) (\(if .work_clone.present then "present, \(.work_clone.unpublished_commits) unpublished commits, \(.work_clone.dirty_files) uncommitted files" else "missing" end))",
           "backup caches: \(.cache_bytes_total) bytes"' <<< "$json"
  fi
  printf '%-9s %-8s %-21s %-14s %s\n' unit enabled "last push" "last result" status
  local line unit enabled push result max then status
  # '|' and not a tab: a tab is IFS whitespace, and an empty field (a unit never
  # pushed) would collapse with its neighbour.
  while IFS='|' read -r unit enabled push result max; do
    status="ok"
    if [ "$enabled" != "true" ]; then
      status="disabled"
    elif [ -z "$push" ]; then
      status="never pushed"
    else
      then=$(date -u -d "$push" +%s 2> /dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$push" +%s 2> /dev/null || echo "")
      if [ -n "$then" ] && [ $((now - then)) -gt $((max * 3600)) ]; then
        status="stale (>${max}h)"
      fi
    fi
    case "$result" in ''|ok|no-change) ;; *) status="$status, last attempt $result" ;; esac
    printf '%-9s %-8s %-21s %-14s %s\n' "$unit" "$enabled" "${push:--}" "${result:--}" "$status"
  done < <(jq -r '.units[] | [.unit, (.enabled | tostring), .last_push, .last_result, (.max_age_hours | tostring)] | join("|")' <<< "$json")
  # 048: where each unit lives with a repository, and the size GitHub reports.
  if [ "$(jq -r '.destination.kind' <<< "$json")" = "repo" ]; then
    jq -r '.units[] | select((.location // "") != "")
           | "location \(.unit): \(if .location == "main" then "main:.agent-backup/" + .unit else "branch:backup/" + .unit end)\(if (.legacy_branch // "") != "" then " (legacy branch: " + .legacy_branch + ")" else "" end)"' <<< "$json"
    jq -r 'if .repo_size_kb != null then "repository size: \(.repo_size_kb) KB" else empty end' <<< "$json"
  fi
}

cmd_kick_channel() {
  if ! command -v tmux >/dev/null 2>&1; then
    echo "heartbeatctl: tmux not available — cannot kick session" >&2
    return 2
  fi
  if ! tmux has-session -t agent 2>/dev/null; then
    echo "heartbeatctl: tmux session 'agent' not found — nothing to kick" >&2
    return 2
  fi
  tmux kill-session -t agent
  echo "heartbeatctl: killed tmux session 'agent' — watchdog will respawn in ~2s"
}

# drop-plugin <spec> — remove a plugin spec from agent.yml.plugins[].
# Idempotent (no-op if spec not in list). Atomic with backup/restore on
# yq failure (matches cmd_pause/cmd_resume pattern). Does NOT auto-kick
# the channel — the caller decides when to recycle the session, since
# the new plugins[] is consumed by ensure_all_plugins_installed on the
# next watchdog respawn either way.
cmd_drop_plugin() {
  local spec="${1:-}"
  if [ -z "$spec" ]; then
    echo "drop-plugin: missing <spec> (e.g. caveman@JuliusBrussee)" >&2
    return 1
  fi
  [ -f "$AGENT_YML" ] || { echo "drop-plugin: $AGENT_YML missing" >&2; return 2; }
  # yq (go-yq, mikefarah) doesn't have jq's `index()`; use `contains`
  # against a single-element array. `.plugins // []` makes the path safe
  # when the field is absent. Prints "true" or "false".
  local present
  present=$(V="$spec" yq '(.plugins // []) | contains([strenv(V)])' "$AGENT_YML" 2>/dev/null)
  if [ "$present" != "true" ]; then
    echo "heartbeatctl: $spec not in agent.yml.plugins — nothing to drop"
    return 0
  fi
  local prev="$AGENT_YML.prev"
  cp "$AGENT_YML" "$prev"
  if ! V="$spec" yq -i '.plugins -= [strenv(V)]' "$AGENT_YML"; then
    cp "$prev" "$AGENT_YML"; rm -f "$prev"
    echo "drop-plugin: yq mutation failed; agent.yml restored from backup" >&2
    return 2
  fi
  rm -f "$prev"
  echo "heartbeatctl: dropped $spec from agent.yml — run 'heartbeatctl kick-channel' to apply"
}

# QMD reindex primitive — keep the vault's semantic index fresh. Invoked by
# both the */5 cron backstop and the inotify watcher (qmd_watch.sh); the
# underlying qmd_reindex is flock-guarded + hash-debounced so the two callers
# never overlap and an unchanged vault skips the costly embed. Always exits 0
# on the run path (a cron tick must never crash). Molded on cmd_backup_vault.
cmd_qmd_reindex() {
  local mode="run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) mode="dry-run"; shift ;;
      -h|--help)
        cat <<EOF
Usage: heartbeatctl qmd-reindex [flags]

Flags:
  --dry-run   Report whether the vault changed without running embed.
  (no flags)  Default: reindex the vault if it changed (flock-guarded).
EOF
        return 0 ;;
      *) echo "qmd-reindex: unknown flag: $1" >&2; return 1 ;;
    esac
  done

  if ! command -v qmd_reindex >/dev/null 2>&1; then
    echo "qmd-reindex: qmd_index.sh not loaded — nothing to do" >&2
    return 0
  fi

  case "$mode" in
    run)     qmd_reindex "$AGENT_YML" ;;
    dry-run) _qmd_reindex_dry ;;
  esac
}

# Dry-run: resolve + hash + report, no embed, no state write.
_qmd_reindex_dry() {
  if ! _qmd_enabled "$AGENT_YML"; then
    echo "qmd-reindex: qmd not enabled in agent.yml"
    return 0
  fi
  local vault_dir current last
  vault_dir=$(qmd_vault_dir "$AGENT_YML")
  if [ -z "$vault_dir" ] || [ ! -d "$vault_dir" ]; then
    echo "qmd-reindex: vault dir unresolved/missing ($vault_dir)"
    return 0
  fi
  current=$(vault_hash "$vault_dir" 2>/dev/null || echo "")
  last=$(qmd_last_hash "$(qmd_state_file)")
  if [ -n "$current" ] && [ "$current" = "$last" ]; then
    echo "qmd-reindex: dry-run — vault unchanged (hash $current), would skip embed"
  else
    echo "qmd-reindex: dry-run — would reindex (from ${last:-<none>} to ${current:-<unknown>})"
  fi
}

# 037: one-time collection migration to the wiki/ mask (contracts/
# qmd-collection-migration.md §3). No flags: idempotent (sentinel present ->
# "already migrated", rc 0, no qmd call at all). --dry-run: state + the six
# steps, no execution. --force: recreates even if already migrated (same
# mask; repairs a stale sentinel or a manual cleanup).
cmd_qmd_migrate() {
  local mode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) mode="--dry-run"; shift ;;
      --force)   mode="--force"; shift ;;
      -h|--help)
        cat <<EOF
Usage: heartbeatctl qmd-migrate [flags]

Move the qmd search collection from the legacy '**/*.md' mask to 'wiki/**/*.md'.
Reuses embeddings (remove+add keys vectors by content hash, not by collection).

Flags:
  --dry-run   Print the current state and the steps, run nothing.
  --force     Recreate the collection even if already migrated.
  (no flags)  Idempotent: migrates if pending, no-ops if already done.
EOF
        return 0 ;;
      *) echo "qmd-migrate: unknown flag: $1" >&2; return 1 ;;
    esac
  done

  if ! command -v qmd_migrate_collection >/dev/null 2>&1; then
    echo "qmd-migrate: qmd_index.sh not loaded — nothing to do" >&2
    return 0
  fi

  if [ "$mode" = "--dry-run" ]; then
    qmd_migrate_collection --dry-run "$AGENT_YML"
    return 0
  fi
  if [ "$mode" = "--force" ]; then
    qmd_migrate_collection --force "$AGENT_YML"
    return $?
  fi
  qmd_migrate_collection "$AGENT_YML"
}

# heartbeatctl wiki-graph — 014: regenerate the derived wiki graph + structural
# lint (flock-guarded, fail-silent). The exact command the cron backstop runs and
# the manual `agentctl heartbeat wiki-graph` action. Always exits 0.
cmd_wiki_graph() {
  case "${1:-}" in
    -h|--help)
      cat <<EOF
Usage: heartbeatctl wiki-graph

Derives <vault>/.graph/{graph,backlinks,findings,policy,packets}.json from the wiki and writes
the wiki-graph.json state file (freshness + finding counts). flock-guarded; safe
to run any time. Never edits the wiki.
EOF
      return 0 ;;
  esac
  if ! command -v wiki_graph_run >/dev/null 2>&1; then
    echo "wiki-graph: wiki_graph.sh not loaded — nothing to do" >&2
    return 0
  fi
  wiki_graph_run "$AGENT_YML"
  if [ -f "$WIKI_GRAPH_STATE_FILE" ] && command -v jq >/dev/null 2>&1; then
    jq -rc '"wiki-graph: \(.last_status) — " + (.counts|tostring)' "$WIKI_GRAPH_STATE_FILE" 2>/dev/null || true
  fi
}

# cmd_token_check — ad-hoc trigger for the token-health probe. Same
# script as the cron tick, just invoked manually. Useful right after
# updating .env or when doctor reports a stale state file.
cmd_token_check() {
  local runner="/opt/agent-admin/scripts/check_token_health.sh"
  if [ ! -x "$runner" ]; then
    # Fallback for tests where the script isn't installed at the
    # canonical path.
    runner="${HEARTBEATCTL_TOKEN_RUNNER:-$runner}"
  fi
  if [ ! -x "$runner" ]; then
    echo "heartbeatctl: token-check runner not found ($runner)" >&2
    return 2
  fi
  "$runner"
}

main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    help|-h|--help|"") cmd_help ;;
    show) cmd_show "$@" ;;
    reload) cmd_reload "$@" ;;
    status) cmd_status "$@" ;;
    logs)   cmd_logs   "$@" ;;
    pause)  cmd_pause ;;
    resume) cmd_resume ;;
    test)   cmd_test "$@" ;;
    kick-channel) cmd_kick_channel ;;
    drop-plugin)  cmd_drop_plugin  "${1:-}" ;;
    backup-identity) cmd_backup_identity "$@" ;;
    backup-vault)    cmd_backup_vault "$@" ;;
    backup-config)   cmd_backup_config "$@" ;;
    backup-memory)   cmd_backup_memory "$@" ;;
    backup-history)  cmd_backup_history "$@" ;;
    backup-status)   cmd_backup_status "$@" ;;
    qmd-reindex)     cmd_qmd_reindex "$@" ;;
    qmd-migrate)     cmd_qmd_migrate "$@" ;;
    wiki-graph)      cmd_wiki_graph "$@" ;;
    token-check)     cmd_token_check ;;
    set-interval) cmd_set_interval "${1:-}" ;;
    set-prompt)   cmd_set_prompt   "${1:-}" ;;
    set-notifier) cmd_set_notifier "${1:-}" ;;
    set-timeout)  cmd_set_timeout  "${1:-}" ;;
    set-retries)  cmd_set_retries  "${1:-}" ;;
    *) echo "heartbeatctl: unknown command '$sub' (see 'heartbeatctl help')" >&2; exit 1 ;;
  esac
}

main "$@"
